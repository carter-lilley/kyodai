<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Root filesystem access (requires MANAGE_EXTERNAL_STORAGE permission) -->
    <!-- This allows serving files from anywhere including SD cards (/storage/XXXX-XXXX/) -->
    <root-path
        name="root"
        path="." />
    
    <!-- External storage (SD card, USB drives) -->
    <external-path
        name="external"
        path="." />
    
    <!-- External files directory (Android/data/com.heckpoint.kyodai/files/) -->
    <external-files-path
        name="external_files"
        path="." />
    
    <!-- External cache directory -->
    <external-cache-path
        name="external_cache"
        path="." />
    
    <!-- Internal app files directory -->
    <files-path
        name="internal"
        path="." />
    
    <!-- Internal cache directory -->
    <cache-path
        name="cache"
        path="." />
</paths>
