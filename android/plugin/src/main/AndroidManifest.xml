<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	package="com.heckpoint.kyodai">
	
	<!-- Permission to query all packages (Android 11+) -->
	<uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

	<!-- Permission to trigger APK installs (sideloaded emulators). Also requires
	     the runtime "Install unknown apps" grant - see installApk() /
	     requestInstallUnknownAppsPermission(). -->
	<uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
	
	<!-- Permission to access all files (for FileProvider to serve external files) -->
	<uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
		android:minSdkVersion="30" />
	
	<!-- Foreground service permission for downloads -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

	<!-- Session wake lock: save upload on game exit must finish even if the
	     device is dozing. Also covers the session WiFi lock. -->
	<uses-permission android:name="android.permission.WAKE_LOCK" />

	<!-- Usage access for the Android presence watch (detecting that the
	     emulator left the foreground without waiting for our own resume).
	     Requires a runtime grant via Settings > Usage access. -->
	<uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
		tools:ignore="ProtectedPermissions" />
	
	<!-- Notification permission for Android 13+ (API 33+) -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	
	<!-- Explicitly declare packages we want to query -->
	<queries>
		<package android:name="com.retroarch" />
		<package android:name="com.retroarch.aarch64" />
		<package android:name="com.retroarch.ra32" />
		<package android:name="io.github.lime3ds.android" />
		<!-- Steam launch backends (isPackageInstalled). DroidDeck ships
		     benchmark-spoof variants with different applicationIds. -->
		<package android:name="app.gamenative" />
		<package android:name="com.droiddeck.launcher" />
		<package android:name="com.droiddeck.launcher.xr" />
		<package android:name="com.antutu.benchmark.full" />
		<package android:name="com.tencent.ig" />
		<package android:name="com.ludashi.benchmark" />
	</queries>
	
	<application
		android:largeHeap="true"
		android:persistent="true"
		android:usesCleartextTraffic="true">
		<!-- usesCleartextTraffic=true is a DELIBERATE choice (KYD-07): RomM
		     servers are self-hosted and very commonly plain http:// on LANs
		     (no certs for LAN IPs), and Android's per-domain cleartext config
		     cannot express runtime user-supplied hosts. Blocking cleartext
		     would break the primary use case. The mitigation lives in the UI:
		     RommConnectionPanel warns and requires explicit acknowledgment
		     before saving or testing an http:// configuration. -->
		<!-- FileProvider for serving ROM files to emulators via content:// URIs -->
		<!-- Uses a unique authority to avoid conflict with Godot's built-in FileProvider -->
		<provider
			android:name="com.heckpoint.kyodai.KyodaiFileProvider"
			android:authorities="${applicationId}.kyodai.fileprovider"
			android:exported="false"
			android:grantUriPermissions="true">
			<meta-data
				android:name="android.support.FILE_PROVIDER_PATHS"
				android:resource="@xml/file_paths" />
		</provider>
		
		<meta-data
			android:name="org.godotengine.plugin.v2.KyodaiBridge"
			android:value="com.heckpoint.kyodai.KyodaiBridgePlugin" />

		<!-- Home-app behavior and Home-intent forwarding live in the patched
		     GodotApp template. Keeping the original activity avoids duplicate
		     launcher routes and preserves Godot's recreate/PiP safeguards. -->
		
		<!-- Foreground service for downloads to prevent app kill during large file downloads -->
		<service
			android:name=".DownloadForegroundService"
			android:enabled="true"
			android:exported="false"
			android:foregroundServiceType="dataSync" />
		
		<!-- Foreground service for metadata sync to prevent app kill during RomM sync -->
		<service
			android:name=".SyncForegroundService"
			android:enabled="true"
			android:exported="false"
			android:foregroundServiceType="dataSync" />

		<!-- Foreground service that owns a game session while the game runs in
		     another app (emulators are prime LMK triggers). Runs in its own
		     tiny process so it survives an LMK sweep of the Godot process:
		     it keeps watching the emulator, records the session end, and
		     cold-starts the launcher into save upload when the game exits.
		     Uses dataSync because the plugin compiles against API 33, where
		     specialUse (API 34+) is not yet a valid foregroundServiceType. -->
		<service
			android:name=".GameSessionForegroundService"
			android:enabled="true"
			android:exported="false"
			android:process=":session"
			android:foregroundServiceType="dataSync" />

		<!-- Silent anchor that holds perceptible priority for the main (Godot)
		     process during a session: startForeground() only promotes the
		     hosting process, so the :session service alone would leave Godot
		     in the cached tier as LMK's first victim. -->
		<service
			android:name=".SessionAnchorForegroundService"
			android:enabled="true"
			android:exported="false"
			android:foregroundServiceType="dataSync" />
		
		<!-- Extraction service running in separate process to avoid sharing Godot's memory budget -->
		<service
			android:name=".ExtractorService"
			android:enabled="true"
			android:exported="false"
			android:process=":extractor"
			android:foregroundServiceType="dataSync" />
	</application>

</manifest>
