<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	package="com.heckpoint.kyodai">
	
	<!-- Permission to query all packages (Android 11+) -->
	<uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

	<!-- Permission to trigger APK installs (sideloaded emulators). Also requires
	     the runtime "Install unknown apps" grant - see installApk() /
	     requestInstallUnknownAppsPermission(). -->
	<uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
	
	<!-- Permission to access all files (for FileProvider to serve external files) -->
	<uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
		android:minSdkVersion="30" />
	
	<!-- Foreground service permission for downloads -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
	
	<!-- Notification permission for Android 13+ (API 33+) -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	
	<!-- Explicitly declare packages we want to query -->
	<queries>
		<package android:name="com.retroarch" />
		<package android:name="com.retroarch.aarch64" />
		<package android:name="com.retroarch.ra32" />
		<package android:name="io.github.lime3ds.android" />
	</queries>
	
	<application
		android:largeHeap="true">
		<!-- FileProvider for serving ROM files to emulators via content:// URIs -->
		<!-- Uses a unique authority to avoid conflict with Godot's built-in FileProvider -->
		<provider
			android:name="com.heckpoint.kyodai.KyodaiFileProvider"
			android:authorities="${applicationId}.kyodai.fileprovider"
			android:exported="false"
			android:grantUriPermissions="true">
			<meta-data
				android:name="android.support.FILE_PROVIDER_PATHS"
				android:resource="@xml/file_paths" />
		</provider>
		
		<meta-data 
			android:name="org.godotengine.plugin.v2.KyodaiBridge" 
			android:value="com.heckpoint.kyodai.KyodaiBridgePlugin" />
		
		<!-- Foreground service for downloads to prevent app kill during large file downloads -->
		<service
			android:name=".DownloadForegroundService"
			android:enabled="true"
			android:exported="false"
			android:foregroundServiceType="dataSync" />
		
		<!-- Foreground service for metadata sync to prevent app kill during RomM sync -->
		<service
			android:name=".SyncForegroundService"
			android:enabled="true"
			android:exported="false"
			android:foregroundServiceType="dataSync" />
		
		<!-- Extraction service running in separate process to avoid sharing Godot's memory budget -->
		<service
			android:name=".ExtractorService"
			android:enabled="true"
			android:exported="false"
			android:process=":extractor"
			android:foregroundServiceType="dataSync" />
	</application>

</manifest>
