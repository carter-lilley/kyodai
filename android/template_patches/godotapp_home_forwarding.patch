+	// kyodai_home_forwarding: GodotPlugin has no onNewIntent hook in 4.7.
+	// Forward only Home intents; all other launch/deep-link behavior stays in
+	// the engine activity.
+	@Override
+	protected void onNewIntent(Intent intent) {
+		super.onNewIntent(intent);
+		if (intent != null && intent.hasCategory(Intent.CATEGORY_HOME)) {
+			KyodaiBridgePlugin bridge = KyodaiBridgePlugin.getInstance();
+			if (bridge != null) {
+				bridge.onHomeIntent();
+			}
+		}
+	}
