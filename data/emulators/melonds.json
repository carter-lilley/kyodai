{
  "suspend_method": "suspend",
  "meta": {
	"id": "melonds",
	"name": "melonDS",
	"platforms": [
      "nds"
	],
	"os": [
      "windows",
      "linux"
	]
  },
  "paths": {
	"default_saves": {
	  "_default": {
		"directories": {
		  "windows": "{games_dir}/nds",
		  "linux": "{games_dir}/nds"
		},
		"extensions": [
          ".sav"
		],
		"uses_folder_saves": false
	  }
	},
	"default_firmware": {
	  "_default": {
		"directories": {
		  "windows": "{emulator_dir}",
		  "linux": "{emulator_dir}"
		}
	  }
	}
  },
  "resolution": {
	"strategy": "melonds_toml",
	"anchor": "{emulator_dir}",
	"config_candidates": {
	  "windows": ["{emulator_dir}/melonDS.toml"],
	  "linux": ["{emulator_dir}/melonDS.toml"]
	}
  },
  "launch": {
	"platforms": {
	  "windows": {
		"type": "command",
		"executable": "melonDS.exe",
		"template": [
		  "{exe}",
		  "{rom}",
          "--fullscreen"
		]
	  },
	  "linux": {
		"type": "command",
		"executable": "melonDS",
		"template": [
		  "{exe}",
          "{rom}"
		]
	  }
	}
  },
  "install": [
	{
	  "step": "download_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "download_repo",
		  "github_repo": "melonDS-emu/melonDS",
		  "asset_pattern": "melonDS-.*-windows-x86_64\\.zip"
		},
		"linux": {
		  "action_type": "download_repo",
		  "github_repo": "melonDS-emu/melonDS",
		  "asset_pattern": "melonDS-.*-appimage-x86_64\\.zip"
		}
	  }
	},
	{
	  "step": "install_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "extract",
		  "extract_to": ".",
		  "strip_top_directory": false,
		  "validate": {
			"action_type": "file_exists",
			"file": "melonDS.exe"
		  }
		},
		"linux": {
		  "action_type": "extract",
		  "extract_to": ".",
		  "strip_top_directory": false,
		  "validate": {
			"action_type": "file_exists",
			"file": "melonDS"
		  }
		}
	  }
	},
	{
	  "step": "create_config",
	  "platforms": {
		"windows": {
		  "action_type": "create_files",
		  "files": [
			{
			  "name": "melonDS.toml",
			  "content": "[Emu]\nConsoleType = 1\nDirectBoot = true\nExternalBIOSEnable = true\n\n[DS]\nFirmwarePath = \"{emulator_dir}/firmware.bin\"\nBIOS7Path = \"{emulator_dir}/bios7.bin\"\nBIOS9Path = \"{emulator_dir}/bios9.bin\"\n\n[DSi]\nExternalBIOSEnable = true\nFullBIOSBoot = false\nFirmwarePath = \"{emulator_dir}/dsi_firmware.bin\"\nBIOS9Path = \"{emulator_dir}/dsi_bios9.bin\"\nBIOS7Path = \"{emulator_dir}/dsi_bios7.bin\"\nNANDPath = \"{emulator_dir}/dsi_nand.bin\""
			}
		  ],
		  "validate": {
			"action_type": "files_exist",
			"files": [
              "melonDS.toml"
			]
		  }
		},
		"linux": {
		  "action_type": "none"
		}
	  }
	}
  ]
}
