{
  "suspend_method": "suspend",
  "meta": {
	"id": "melonds",
	"name": "melonDS",
	"platforms": [
      "nds"
	],
	"os": [
      "windows",
      "linux"
	]
  },
  "paths": {
	"default_saves": {
	  "_default": {
		"directories": {
		  "windows": "{games_dir}/nds",
		  "linux": "{games_dir}/nds"
		},
		"extensions": [
          ".sav"
		],
		"uses_folder_saves": false
	  }
	},
	"default_firmware": {
	  "_default": {
		"directories": {
		  "windows": "{emulator_dir}",
		  "linux": "{emulator_dir}"
		}
	  }
	}
  },
  "resolution": {
	"strategy": "melonds_ini",
	"anchor": "{emulator_dir}",
	"config_candidates": {
	  "windows": ["{emulator_dir}/melonDS.ini"],
	  "linux": ["{emulator_dir}/.config/melonDS/melonDS.ini", "{emulator_dir}/melonDS.ini"]
	},
	"enforce": {
	  "windows": {
		"sections": {
		  "Emu": {
			"ConsoleType": "1",
			"DirectBoot": "true",
			"ExternalBIOSEnable": "true"
		  },
		  "DS": {
			"FirmwarePath": "{emulator_dir}/firmware.bin",
			"BIOS9Path": "{emulator_dir}/bios9.bin",
			"BIOS7Path": "{emulator_dir}/bios7.bin"
		  },
		  "DSi": {
			"FirmwarePath": "{emulator_dir}/dsi_firmware.bin",
			"BIOS9Path": "{emulator_dir}/dsi_bios9.bin",
			"BIOS7Path": "{emulator_dir}/dsi_bios7.bin",
			"NANDPath": "{emulator_dir}/dsi_nand.bin"
		  }
		}
	  },
	  "linux": {
		"sections": {
		  "Emu": {
			"ConsoleType": "1",
			"DirectBoot": "true",
			"ExternalBIOSEnable": "true"
		  },
		  "DS": {
			"FirmwarePath": "{emulator_dir}/firmware.bin",
			"BIOS9Path": "{emulator_dir}/bios9.bin",
			"BIOS7Path": "{emulator_dir}/bios7.bin"
		  },
		  "DSi": {
			"FirmwarePath": "{emulator_dir}/dsi_firmware.bin",
			"BIOS9Path": "{emulator_dir}/dsi_bios9.bin",
			"BIOS7Path": "{emulator_dir}/dsi_bios7.bin",
			"NANDPath": "{emulator_dir}/dsi_nand.bin"
		  }
		}
	  }
	}
  },
  "launch": {
	"platforms": {
	  "windows": {
		"type": "command",
		"executable": "melonDS.exe",
		"working_directory": "{emulator_dir}",
		"template": [
		  "{exe}",
		  "{rom}",
          "--fullscreen"
		]
	  },
	  "linux": {
		"type": "command",
		"executable": "squashfs-root/AppRun",
		"working_directory": "{emulator_dir}",
		"template": [
		  "{exe}",
		  "-f",
		  "{rom}"
		],
		"environment": {
		  "XDG_CONFIG_HOME": "{emulator_dir}/.config",
		  "XDG_DATA_HOME": "{emulator_dir}/.local/share",
		  "XDG_CACHE_HOME": "{emulator_dir}/.cache"
		}
	  }
	}
  },
  "install": [
	{
	  "step": "download_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "download_repo",
		  "github_repo": "melonDS-emu/melonDS",
		  "asset_pattern": "melonDS-.*-windows-x86_64\\.zip"
		},
		"linux": {
		  "action_type": "download_repo",
		  "github_repo": "melonDS-emu/melonDS",
		  "asset_pattern": "melonDS-.*-appimage-x86_64\\.zip"
		}
	  }
	},
	{
	  "step": "install_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "extract",
		  "extract_to": ".",
		  "strip_top_directory": false,
		  "validate": {
			"action_type": "file_exists",
			"file": "melonDS.exe"
		  }
		},
		"linux": {
		  "action_type": "extract",
		  "extract_to": ".",
		  "strip_top_directory": false
		}
	  }
	},
	{
	  "step": "chmod_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "none"
		},
		"linux": {
		  "action_type": "chmod",
		  "file": "melonDS",
		  "mode": "+x"
		}
	  }
	},
	{
	  "step": "extract_appimage",
	  "platforms": {
		"windows": {
		  "action_type": "none"
		},
		"linux": {
		  "action_type": "appimage_extract",
		  "pattern": "melonDS",
		  "validate": {
			"action_type": "files_exist",
			"path": "squashfs-root",
			"pattern": "AppRun"
		  }
		}
	  }
	}
  ]
}
