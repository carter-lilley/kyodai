{
	"meta": {
		"id": "hakux",
		"name": "hakuX",
		"architecture": "hakux",
		"platforms": [
			"xbox"
		],
		"os": [
			"android"
		]
	},
	"paths": {
		"default_saves": {
			"_default": {
				"directories": {},
				"extensions": [],
				"uses_folder_saves": false
			}
		}
	},
	"resolution": {
		"strategy": "none"
	},
	"launch": {
		"platforms": {
			"android": {
				"action": "android.intent.action.VIEW",
				"package": "com.rfandango.haku_x",
				"class": "com.rfandango.haku_x.LauncherActivity",
				"rom_delivery": "intent_data"
			}
		}
	},
	"discover": {
		"android": {
			"setup_prompt": "Open hakuX once and pick your Xbox games folder when prompted - that is the entire setup (hakuX needs no BIOS). Launches from kyodai are ignored until a folder is picked."
		}
	},
	"install": [
		{
			"step": "download_emulator",
			"platforms": {
				"android": {
					"action_type": "download_repo",
					"github_repo": "rfandango/hakuX",
					"asset_pattern": "hakuX-.*\\.apk"
				}
			}
		},
		{
			"step": "install_emulator",
			"platforms": {
				"android": {
					"action_type": "apk_install",
					"package_name": "com.rfandango.haku_x",
					"expected_file": "hakuX-*.apk",
					"validate": {
						"action_type": "package_installed",
						"package": "com.rfandango.haku_x"
					}
				}
			}
		}
	]
}
