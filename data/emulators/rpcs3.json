{
  "meta": {
	"id": "rpcs3",
	"name": "RPCS3",
	"platforms": [
      "ps3"
	]
  },
  "paths": {
	"saves": {
	  "_default": {
		"directories": {
		  "windows": "{emulator_dir}/dev_hdd0/home/00000001/savedata",
		  "linux": "{emulator_dir}/dev_hdd0/home/00000001/savedata",
		  "android": "{app_data}/config/dev_hdd0/home/00000001/savedata"
		},
		"extensions": [
          "*"
		],
		"uses_folder_saves": true
	  }
	},
	"firmware": {
	  "_default": {
		"directories": {
		  "windows": "{emulator_dir}",
		  "linux": "{emulator_dir}",
		  "android": "{emulator_dir}"
		}
	  }
	}
  },
  "launch": {
	"platforms": {
	  "windows": {
		"type": "command",
		"executable": "rpcs3.exe",
		"template": [
		  "{exe}",
		  "{rom}",
          "--no-gui"
		],
		"rom_delivery": "none"
	  },
	  "linux": {
		"action_type": "none"
	  },
	  "android": {
		"action": "aenu.intent.action.APS3E",
		"package": "aenu.aps3e",
		"class": "aenu.aps3e.EmulatorActivity",
		"rom_delivery": "none",
		"extras": [
		  {"key": "game_dir", "value": "{rom}", "type": "file_path"}
		]
	  }
	}
  },
  "install": [
	{
	  "step": "download_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "download_repo",
		  "github_repo": "RPCS3/rpcs3-binaries-win",
		  "asset_pattern": "rpcs3-.*_win64_msvc\\.7z"
		},
		"linux": {
		  "action_type": "none"
		},
		"android": {
		  "action_type": "download_repo",
		  "github_repo": "aenu1/aps3e",
		  "asset_pattern": ".*\\.apk"
		}
	  }
	},
	{
	  "step": "install_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "extract",
		  "extract_to": ".",
		  "strip_top_directory": true,
		  "validate": {
			"action_type": "file_exists",
			"file": "rpcs3.exe"
		  }
		},
		"linux": {
		  "action_type": "none"
		},
		"android": {
		  "action_type": "apk_install",
		  "package_name": "aenu.aps3e",
		  "expected_file": "*.apk",
		  "validate": {
			"action_type": "package_installed",
			"package": "aenu.aps3e"
		  }
		}
	  }
	}
  ]
}
