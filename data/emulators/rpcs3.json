{
  "suspend_method": "suspend",
  "meta": {
	"id": "rpcs3",
	"name": "RPCS3",
	"platforms": [
      "ps3"
	],
	"os": [
	  "windows",
      "linux"
	]
  },
  "paths": {
	"default_saves": {
	  "_default": {
		"directories": {
		  "windows": "{emulator_dir}/dev_hdd0/home/00000001/savedata",
		  "linux": "{emulator_dir}/dev_hdd0/home/00000001/savedata"
		},
		"extensions": [
          "*"
		],
		"uses_folder_saves": true
	  }
	},
	"default_firmware": {
	  "_default": {
		"directories": {
		  "windows": "{emulator_dir}",
		  "linux": "{emulator_dir}"
		}
	  }
	}
  },
  "resolution": {
	"strategy": "rpcs3_vfs",
	"anchor": "{emulator_dir}",
	"config_candidates": {
	  "windows": [
		"{home}/AppData/Roaming/RPCS3/vfs.yml",
		"{home}/AppData/Roaming/RPCS3/config.yml"
	  ],
	  "linux": [
		"{emulator_dir}/.config/rpcs3/vfs.yml",
		"{emulator_dir}/.config/rpcs3/config.yml"
	  ]
	},
	"enforce": {
	  "windows": {
		"sections": {
		  "": {
			"/dev_hdd0/": "{emulator_dir}/dev_hdd0",
			"/dev_flash/": "{emulator_dir}/dev_flash"
		  }
		}
	  },
	  "linux": {
		"sections": {
		  "": {
			"/dev_hdd0/": "{emulator_dir}/dev_hdd0",
			"/dev_flash/": "{emulator_dir}/dev_flash"
		  }
		}
	  }
	}
  },
  "launch": {
	"platforms": {
	  "windows": {
		"type": "command",
		"executable": "rpcs3.exe",
		"template": [
		  "{exe}",
		  "{rom}",
          "--no-gui"
		],
		"rom_delivery": "none"
	  },
	  "linux": {
		"type": "command",
		"executable": "rpcs3",
		"template": [
		  "{exe}",
		  "{rom}",
		  "--no-gui"
		],
		"rom_delivery": "none",
		"environment": {
		  "XDG_CONFIG_HOME": "{emulator_dir}/.config",
		  "XDG_DATA_HOME": "{emulator_dir}/.local/share",
		  "XDG_CACHE_HOME": "{emulator_dir}/.cache"
		}
	  }
	}
  },
  "install": [
	{
	  "step": "download_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "download_repo",
		  "github_repo": "RPCS3/rpcs3-binaries-win",
		  "asset_pattern": "rpcs3-.*_win64_msvc\\.7z"
		},
		"linux": {
		  "action_type": "download_repo",
		  "github_repo": "RPCS3/rpcs3-binaries-linux",
		  "asset_pattern": "rpcs3-.*_linux64\\.AppImage"
		}
	  }
	},
	{
	  "step": "install_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "extract",
		  "extract_to": ".",
		  "strip_top_directory": true,
		  "validate": {
			"action_type": "file_exists",
			"file": "rpcs3.exe"
		  }
		},
		"linux": {
		  "action_type": "move",
		  "source_pattern": "rpcs3-*.AppImage",
		  "destination": "rpcs3",
		  "replace": true,
		  "validate": {
			"action_type": "file_exists",
			"file": "rpcs3"
		  }
		}
	  }
	},
	{
	  "step": "chmod_executable",
	  "platforms": {
		"windows": {
		  "action_type": "none"
		},
		"linux": {
		  "action_type": "chmod",
		  "file": "rpcs3",
		  "mode": "+x",
		  "validate": {
			"action_type": "file_exists",
			"file": "rpcs3"
		  }
		}
	  }
	}
  ]
}
