{
  "suspend_method": "suspend",
  "meta": {
	"id": "rpcs3",
	"name": "RPCS3",
	"platforms": [
      "ps3"
	],
	"os": [
	  "windows",
      "linux"
	]
  },
  "paths": {
	"saves": {
	  "_default": {
		"directories": {
		  "windows": "{emulator_dir}/dev_hdd0/home/00000001/savedata",
		  "linux": "{emulator_dir}/dev_hdd0/home/00000001/savedata"
		},
		"extensions": [
          "*"
		],
		"uses_folder_saves": true
	  }
	},
	"firmware": {
	  "_default": {
		"directories": {
		  "windows": "{emulator_dir}",
		  "linux": "{emulator_dir}"
		}
	  }
	}
  },
  "launch": {
	"platforms": {
	  "windows": {
		"type": "command",
		"executable": "rpcs3.exe",
		"template": [
		  "{exe}",
		  "{rom}",
          "--no-gui"
		],
		"rom_delivery": "none"
	  },
	  "linux": {
		"action_type": "none"
	  }
	}
  },
  "install": [
	{
	  "step": "download_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "download_repo",
		  "github_repo": "RPCS3/rpcs3-binaries-win",
		  "asset_pattern": "rpcs3-.*_win64_msvc\\.7z"
		},
		"linux": {
		  "action_type": "none"
		}
	  }
	},
	{
	  "step": "install_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "extract",
		  "extract_to": ".",
		  "strip_top_directory": true,
		  "validate": {
			"action_type": "file_exists",
			"file": "rpcs3.exe"
		  }
		},
		"linux": {
		  "action_type": "none"
		}
	  }
	}
  ]
}
