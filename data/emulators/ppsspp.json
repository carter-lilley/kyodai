{
	"suspend_method": "suspend",
	"meta": {
		"id": "ppsspp",
		"name": "PPSSPP",
		"platforms": [
			"psp"
		],
		"os": [
			"windows",
			"linux",
			"android"
		]
	},
	"paths": {
		"default_saves": {
			"_default": {
				"directories": {
					"windows": "{emulator_dir}/memstick/PSP/SAVEDATA",
					"linux": "{emulator_dir}/memstick/PSP/SAVEDATA",
					"android": "{app_data}/PSP/SAVEDATA"
				},
				"extensions": [
					"*"
				],
				"uses_folder_saves": true
			}
		},
		"default_firmware": {
			"_default": {
				"directories": {}
			}
		}
	},
	"resolution": {
		"strategy": "ppsspp_ini",
		"anchor": "{emulator_dir}",
		"candidate_selection": "newest_mtime",
		"config_candidates": {
			"windows": [
				"{emulator_dir}/memstick/PSP/SYSTEM/ppsspp.ini"
			],
			"linux": [
				"{emulator_dir}/memstick/PSP/SYSTEM/ppsspp.ini"
			],
			"android": [
				"{emulator_dir}/PSP/SYSTEM/ppsspp.ini",
				"{app_data}/PSP/SYSTEM/ppsspp.ini"
			]
		},
		"enforce": {
			"windows": {
				"sections": {
					"General": {
						"MemStickDirectory": "{emulator_dir}/memstick"
					}
				}
			},
			"linux": {
				"sections": {
					"General": {
						"MemStickDirectory": "{emulator_dir}/memstick"
					}
				}
			},
			"android": {
				"sections": {
					"General": {
						"MemStickDirectory": "{emulator_dir}"
					}
				}
			}
		}
	},
	"launch": {
		"platforms": {
			"windows": {
				"type": "command",
				"executable": "PPSSPPWindows64.exe",
				"template": [
					"{exe}",
					"{rom}",
					"--fullscreen"
				]
			},
			"linux": {
				"type": "command",
				"executable": "squashfs-root/AppRun",
				"template": [
					"{exe}",
					"{rom}",
					"--fullscreen"
				]
			},
			"android": {
				"action": "android.intent.action.VIEW",
				"package": "org.ppsspp.ppsspp",
				"rom_delivery": "intent_data"
			}
		}
	},
	"install": [
		{
			"step": "download_emulator",
			"platforms": {
				"windows": {
					"action_type": "download_scrape",
					"scrape_url": "https://www.ppsspp.org/download/",
					"version_pattern": "files/([0-9]+_[0-9]+_[0-9]+)/ppsspp_win\\.zip",
					"url_template": "https://www.ppsspp.org/files/{version}/ppsspp_win.zip"
				},
				"linux": {
					"action_type": "download_repo",
					"github_repo": "hrydgard/ppsspp",
					"asset_pattern": "PPSSPP-.*-anylinux-x86_64\\.AppImage"
				},
				"android": {
					"action_type": "download_scrape",
					"scrape_url": "https://www.ppsspp.org/download/",
					"version_pattern": "files/([0-9]+_[0-9]+_[0-9]+)/ppsspp\\.apk",
					"url_template": "https://www.ppsspp.org/files/{version}/ppsspp.apk"
				}
			}
		},
		{
			"step": "install_emulator",
			"platforms": {
				"windows": {
					"action_type": "extract",
					"expected_file": "ppsspp_win.zip",
					"extract_to": ".",
					"strip_top_directory": true,
					"validate": {
						"action_type": "file_exists",
						"file": "PPSSPPWindows64.exe"
					}
				},
				"linux": {
					"action_type": "none"
				},
				"android": {
					"action_type": "apk_install",
					"package_name": "org.ppsspp.ppsspp",
					"expected_file": "ppsspp.apk",
					"validate": {
						"action_type": "package_installed",
						"package": "org.ppsspp.ppsspp"
					}
				}
			}
		},
		{
			"step": "chmod_emulator",
			"platforms": {
				"windows": {
					"action_type": "none"
				},
				"android": {
					"action_type": "none"
				},
				"linux": {
					"action_type": "chmod",
					"pattern": "PPSSPP-*.AppImage"
				}
			}
		},
		{
			"step": "extract_appimage",
			"platforms": {
				"windows": {
					"action_type": "none"
				},
				"android": {
					"action_type": "none"
				},
				"linux": {
					"action_type": "appimage_extract",
					"pattern": "PPSSPP-*.AppImage",
					"validate": {
						"action_type": "files_exist",
						"path": "squashfs-root",
						"pattern": "AppRun"
					}
				}
			}
		},
		{
			"step": "create_portable_file",
			"platforms": {
				"windows": {
					"action_type": "create_files",
					"files": [
						{
							"name": "portable.txt",
							"content": ""
						}
					],
					"validate": {
						"action_type": "file_exists",
						"file": "portable.txt"
					}
				},
				"linux": {
					"action_type": "none"
				},
				"android": {
					"action_type": "none"
				}
			}
		}
	]
}
