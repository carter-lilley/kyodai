{
  "suspend_method": "suspend",
  "meta": {
	"id": "xenia-edge",
	"name": "Xenia Edge",
	"architecture": "xenia",
	"platforms": [
      "xbox360"
	],
	"os": [
	  "windows",
      "linux"
	]
  },
  "paths": {
	"default_saves": {
	  "_default": {
		"directories": {
		  "windows": "{emulator_dir}/content",
		  "linux": "{emulator_dir}/content"
		},
		"extensions": [
          ".zip"
		],
		"uses_folder_saves": true
	  }
	},
	"default_firmware": {
	  "_default": {
		"directories": {}
	  }
	}
  },
  "resolution": {
	"strategy": "xenia_toml",
	"config_candidates": {
	  "windows": [
		"{emulator_dir}/xenia-edge.config.toml",
		"{emulator_dir}/xenia.config.toml"
	  ],
	  "linux": [
		"{emulator_dir}/xenia-edge.config.toml",
		"{emulator_dir}/xenia.config.toml"
	  ]
	},
	"enforce": {
	  "windows": {
		"sections": {
		  "Storage": {
			"content_root": "{emulator_dir}/content"
		  }
		}
	  },
	  "linux": {
		"sections": {
		  "Storage": {
			"content_root": "{emulator_dir}/content"
		  }
		}
	  }
	}
  },
  "launch": {
	"platforms": {
	  "windows": {
		"type": "command",
		"executable": "xenia_edge.exe",
		"template": [
		  "{exe}",
		  "{rom}",
          "--fullscreen"
		]
	  },
	  "linux": {
		"type": "command",
		"executable": "xenia_edge_linux.AppImage",
		"template": [
		  "{exe}",
		  "--fullscreen=true",
		  "{rom}"
		]
	  }
	}
  },
  "install": [
	{
	  "step": "download_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "download_repo",
		  "github_repo": "has207/xenia-edge",
		  "asset_pattern": "xenia_edge_windows\\.zip"
		},
		"linux": {
		  "action_type": "download_repo",
		  "github_repo": "has207/xenia-edge",
		  "asset_pattern": "xenia_edge_linux\\.AppImage",
		  "validate": {
			"action_type": "file_exists",
			"file": "xenia_edge_linux.AppImage"
		  }
		}
	  }
	},
	{
	  "step": "install_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "extract",
		  "extract_to": ".",
		  "strip_top_directory": true,
		  "validate": {
			"action_type": "file_exists",
			"file": "xenia_edge.exe"
		  }
		},
		"linux": {
		  "action_type": "none"
		}
	  }
	},
	{
	  "step": "chmod_executable",
	  "platforms": {
		"windows": {
		  "action_type": "none"
		},
		"linux": {
		  "action_type": "chmod",
		  "file": "xenia_edge_linux.AppImage",
		  "mode": "+x",
		  "validate": {
			"action_type": "file_exists",
			"file": "xenia_edge_linux.AppImage"
		  }
		}
	  }
	},
	{
	  "step": "create_portable_file",
	  "platforms": {
		"windows": {
		  "action_type": "create_files",
		  "files": [
			{
			  "name": "portable.txt",
			  "content": ""
			}
		  ],
		  "validate": {
			"action_type": "file_exists",
			"file": "portable.txt"
		  }
		},
		"linux": {
		  "action_type": "create_files",
		  "files": [
			{
			  "name": "portable.txt",
			  "content": ""
			}
		  ],
		  "validate": {
			"action_type": "file_exists",
			"file": "portable.txt"
		  }
		}
	  }
	}
  ]
}
