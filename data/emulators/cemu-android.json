{
  "suspend_method": "suspend",
  "meta": {
	"id": "cemu-android",
	"name": "Cemu Android",
	"architecture": "cemu",
	"platforms": [
      "wiiu"
	],
	"os": [
      "android"
	]
  },
  "paths": {
	"saves": {
	  "_default": {
		"directories": {
		  "android": "{app_data}/mlc01/usr/save/00050000"
		},
		"extensions": [
          "*"
		],
		"uses_folder_saves": true
	  }
	},
	"firmware": {
	  "_default": {
		"directories": {}
	  }
	}
  },
  "launch": {
	"platforms": {
	  "android": {
		"action": "android.intent.action.VIEW",
		"package": "info.cemu.cemu",
		"rom_delivery": "intent_data"
	  }
	}
  },
  "install": [
	{
	  "step": "download_emulator",
	  "platforms": {
		"android": {
		  "action_type": "download_repo",
		  "github_repo": "SSimco/Cemu",
		  "asset_pattern": "Cemu-.*\\.apk"
		}
	  }
	},
	{
	  "step": "install_emulator",
	  "platforms": {
		"android": {
		  "action_type": "apk_install",
		  "package_name": "info.cemu.cemu",
		  "expected_file": "Cemu-*.apk",
		  "validate": {
			"action_type": "package_installed",
			"package": "info.cemu.cemu"
		  }
		}
	  }
	}
  ]
}
