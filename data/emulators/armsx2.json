{
  "suspend_method": "suspend",
  "meta": {
	"id": "armsx2",
	"name": "ARMSX2",
	"architecture": "pcsx2",
	"platforms": [
      "ps2"
	],
	"os": [
      "android"
	]
  },
  "paths": {
	"saves": {
	  "_default": {
		"directories": {
		  "android": "{app_data}/memcards/main.ps2"
		},
		"extensions": [
          "*"
		],
		"uses_folder_saves": true
	  }
	},
	"firmware": {
	  "_default": {
		"directories": {
		  "android": "{app_data}"
		}
	  }
	}
  },
  "launch": {
	"platforms": {
	  "android": {
		"action": "android.intent.action.VIEW",
		"package": "com.armsx2",
		"class": "com.armsx2.BootSplashActivity",
		"rom_delivery": "intent_data",
		"mime_type": "application/octet-stream"
	  }
	}
  },
  "install": [
	{
	  "step": "download_emulator",
	  "platforms": {
		"android": {
		  "action_type": "download_repo",
		  "github_repo": "ARMSX2/ARMSX2",
		  "asset_pattern": "ARMSX2-.*-a11-armv8\\.2-sdk30\\.apk"
		}
	  }
	},
	{
	  "step": "install_emulator",
	  "platforms": {
		"android": {
		  "action_type": "apk_install",
		  "package_name": "com.armsx2",
		  "expected_file": "ARMSX2-*-a11-*.apk",
		  "validate": {
			"action_type": "package_installed",
			"package": "com.armsx2"
		  }
		}
	  }
	},
	{
	  "step": "create_memcards_dir",
	  "platforms": {
		"android": {
		  "action_type": "create_folders",
		  "folders": [
            "{app_data}/memcards/main.ps2"
		  ],
		  "validate": {
			"action_type": "folder_exists",
			"path": "{app_data}/memcards/main.ps2"
		  }
		}
	  }
	},
	{
	  "step": "create_superblock",
	  "platforms": {
		"android": {
		  "action_type": "create_pcsx2_superblock",
		  "path": "memcards/main.ps2",
		  "validate": {
			"action_type": "files_exist",
			"files": [
              "{app_data}/memcards/main.ps2/_pcsx2_superblock"
			]
		  }
		}
	  }
	}
  ]
}
