{
  "suspend_method": "suspend",
  "meta": {
	"id": "dolphin",
	"name": "Dolphin",
	"platforms": [
	  "ngc",
      "wii"
	],
	"os": [
	  "windows",
	  "linux",
      "android"
	]
  },
  "paths": {
	"default_saves": {
	  "ngc": {
		"directories": {
		  "windows": "{emulator_dir}/User/GC",
		  "android": "{app_data}/GC"
		},
		"extensions": [
          "gci"
		],
		"uses_folder_saves": false
	  },
	  "wii": {
		"directories": {
		  "windows": "{emulator_dir}/User/Wii/title/00010000",
		  "android": "{app_data}/Wii/title/00010000"
		},
		"extensions": [
          "zip"
		],
		"uses_folder_saves": true
	  }
	},
	"default_firmware": {
	  "_default": {
		"directories": {}
	  }
	}
  },
	"resolution": {
	"strategy": "dolphin_ini",
	"config_candidates": {
	  "windows": ["{emulator_dir}/User/Config/Dolphin.ini"],
	  "linux": ["{emulator_dir}/.config/dolphin-emu/Dolphin.ini"],
	  "android": ["{app_data}/Config/Dolphin.ini"]
	},
	"enforce": {
	  "windows": {
		"sections": {
		  "Core": {
			"SlotA": "GCI Folder",
			"GCIFolderAPath": "{emulator_dir}/User/GC"
		  },
		  "General": {
			"NANDRootPath": "{emulator_dir}/User/Wii"
		  },
		  "Display": {
			"Fullscreen": "True"
		  },
		  "Interface": {
			"ConfirmStop": "False"
		  }
		}
	  },
	  "linux": {
		"sections": {
		  "Core": {
			"SlotA": "GCI Folder",
			"GCIFolderAPath": "{emulator_dir}/.local/share/dolphin-emu/GC"
		  },
		  "General": {
			"NANDRootPath": "{emulator_dir}/.local/share/dolphin-emu/Wii"
		  },
		  "Display": {
			"Fullscreen": "True"
		  },
		  "Interface": {
			"ConfirmStop": "False"
		  }
		}
	  }
	}
  },
  "launch": {
	"platforms": {
	  "windows": {
		"type": "command",
		"executable": "Dolphin.exe",
		"template": [
		  "{exe}",
		  "-e",
		  "{rom}",
		  "--batch"
		]
	  },
	  "linux": {
		"type": "command",
		"executable": "squashfs-root/AppRun",
		"template": [
		  "{exe}",
		  "-e",
		  "{rom}",
		  "--batch"
		],
		"environment": {
		  "XDG_CONFIG_HOME": "{emulator_dir}/.config",
		  "XDG_DATA_HOME": "{emulator_dir}/.local/share",
		  "XDG_CACHE_HOME": "{emulator_dir}/.cache"
		}
	  },
	  "android": {
		"action": "android.intent.action.MAIN",
		"package": "org.dolphinemu.dolphinemu",
		"class": "org.dolphinemu.dolphinemu.ui.main.MainActivity",
		"rom_delivery": "extra",
		"extras": [
		  {
			"key": "AutoStartFile",
			"value": "{rom}",
			"type": "content_uri"
		  }
		]
	  }
	}
  },
  "install": [
	{
	  "step": "download_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "download_scrape",
		  "scrape_url": "https://api.github.com/repos/dolphin-emu/dolphin/tags?per_page=20",
		  "json_path": "[*].name",
		  "version_pattern": "^([0-9]+[a-z]*)$",
		  "url_template": "https://dl.dolphin-emu.org/releases/{version}/dolphin-{version}-x64.7z"
		},
		"linux": {
		  "action_type": "download_repo",
		  "github_repo": "pkgforge-dev/Dolphin-emu-AppImage",
		  "asset_pattern": "Dolphin_Emulator-.*-anylinux-x86_64\\.AppImage"
		},
		"android": {
		  "action_type": "download_scrape",
		  "scrape_url": "https://api.github.com/repos/dolphin-emu/dolphin/tags?per_page=20",
		  "json_path": "[*].name",
		  "version_pattern": "^([0-9]+[a-z]*)$",
		  "url_template": "https://dl.dolphin-emu.org/releases/{version}/dolphin-{version}.apk"
		}
	  }
	},
	{
	  "step": "install_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "extract",
		  "extract_to": ".",
		  "strip_top_directory": true,
		  "validate": {
			"action_type": "file_exists",
			"file": "Dolphin.exe"
		  }
		},
		"linux": {
		  "action_type": "none"
		},
		"android": {
		  "action_type": "apk_install",
		  "package_name": "org.dolphinemu.dolphinemu",
		  "expected_file": "dolphin-*.apk",
		  "validate": {
			"action_type": "package_installed",
			"package": "org.dolphinemu.dolphinemu"
		  }
		}
	  }
	},
	{
	  "step": "chmod_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "none"
		},
		"linux": {
		  "action_type": "chmod",
		  "pattern": "Dolphin_Emulator-*.AppImage"
		},
		"android": {
		  "action_type": "none"
		}
	  }
	},
	{
	  "step": "extract_appimage",
	  "platforms": {
		"windows": {
		  "action_type": "none"
		},
		"linux": {
		  "action_type": "appimage_extract",
		  "pattern": "Dolphin_Emulator-*.AppImage",
		  "validate": {
			"action_type": "files_exist",
			"path": "squashfs-root",
			"pattern": "AppRun"
		  }
		},
		"android": {
		  "action_type": "none"
		}
	  }
	},
	{
	  "step": "setup_portable_mode",
	  "platforms": {
		"windows": {
		  "action_type": "create_files",
		  "files": [
            "portable.txt"
		  ],
		  "validate": {
			"action_type": "files_exist",
			"files": [
              "portable.txt"
			]
		  }
		},
		"linux": {
		  "action_type": "none"
		},
		"android": {
		  "action_type": "none"
		}
	  }
	}
  ]
}
