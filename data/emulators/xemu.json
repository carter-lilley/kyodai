{
  "suspend_method": "tcp",
  "meta": {
	"id": "xemu",
	"name": "Xemu",
	"platforms": [
      "xbox"
	],
	"os": [
	  "windows",
      "linux"
	]
  },
  "paths": {
	"default_saves": {
	  "_default": {
		"directories": {},
		"extensions": [],
		"uses_folder_saves": false
	  }
	},
	"default_firmware": {
	  "_default": {
		"directories": {
		  "windows": "{emulator_dir}",
		  "linux": "{emulator_dir}"
		}
	  }
	}
  },
  "resolution": {
	"strategy": "xemu_toml",
	"config_candidates": {
	  "windows": ["{emulator_dir}/xemu.toml"],
	  "linux": ["{emulator_dir}/.local/share/xemu/xemu/xemu.toml"]
	},
	"enforce": {
	  "windows": {
		"sections": {
		  "general": {
			"show_welcome": "false"
		  },
		  "sys.files": {
			"bootrom_path": "{emulator_dir}/mcpx_1.0.bin",
			"flashrom_path": "{emulator_dir}/Complex_4627.bin",
			"eeprom_path": "{emulator_dir}/eeprom.bin",
			"hdd_path": "{emulator_dir}/xbox_hdd.raw"
		  }
		}
	  },
	  "linux": {
		"sections": {
		  "general": {
			"show_welcome": "false"
		  },
		  "sys.files": {
			"bootrom_path": "{emulator_dir}/mcpx_1.0.bin",
			"flashrom_path": "{emulator_dir}/Complex_4627.bin",
			"eeprom_path": "{emulator_dir}/eeprom.bin",
			"hdd_path": "{emulator_dir}/xbox_hdd.qcow2"
		  }
		}
	  }
	}
  },
  "launch": {
	"platforms": {
	  "windows": {
		"type": "command",
		"executable": "xemu.exe",
		"template": [
		  "{exe}",
		  "-full-screen",
		  "-dvd_path",
          "{rom}"
		]
	  },
	  "linux": {
		"type": "command",
		"executable": "squashfs-root/AppRun",
		"template": [
		  "{exe}",
		  "-full-screen",
		  "-dvd_path",
		  "{rom}"
		],
		"environment": {
		  "XDG_CONFIG_HOME": "{emulator_dir}/.config",
		  "XDG_DATA_HOME": "{emulator_dir}/.local/share",
		  "XDG_CACHE_HOME": "{emulator_dir}/.cache"
		}
	  }
	}
  },
  "install": [
	{
	  "step": "download_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "download_repo",
		  "github_repo": "xemu-project/xemu",
		  "release_tag": "pre-release",
		  "asset_pattern": "^xemu-(?!.*-dbg-).*-windows-x86_64\\.zip$"
		},
		"linux": {
		  "action_type": "download_repo",
		  "github_repo": "xemu-project/xemu",
		  "release_tag": "pre-release",
		  "asset_pattern": "^xemu-(?!.*-dbg-).*-x86_64\\.AppImage$"
		}
	  }
	},
	{
	  "step": "install_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "extract",
		  "extract_to": ".",
		  "strip_top_directory": true,
		  "validate": {
			"action_type": "file_exists",
			"file": "xemu.exe"
		  }
		},
		"linux": {
		  "action_type": "move",
		  "source_pattern": "xemu-*.AppImage",
		  "destination": "xemu",
		  "replace": true
		}
	  }
	},
	{
	  "step": "chmod_executable",
	  "platforms": {
		"windows": {
		  "action_type": "none"
		},
		"linux": {
		  "action_type": "chmod",
		  "file": "xemu",
		  "mode": "+x"
		}
	  }
	},
	{
	  "step": "extract_appimage",
	  "platforms": {
		"windows": {
		  "action_type": "none"
		},
		"linux": {
		  "action_type": "appimage_extract",
		  "pattern": "xemu",
		  "validate": {
			"action_type": "files_exist",
			"path": "squashfs-root",
			"pattern": "AppRun"
		  }
		}
	  }
	}
  ]
}
