{
  "suspend_method": "tcp",
  "meta": {
	"id": "xemu",
	"name": "Xemu",
	"platforms": [
      "xbox"
	],
	"os": [
	  "windows",
      "linux"
	]
  },
  "requires_working_dir": true,
  "paths": {
	"saves": {
	  "_default": {
		"directories": {},
		"extensions": [],
		"uses_folder_saves": false
	  }
	},
	"firmware": {
	  "_default": {
		"directories": {
		  "windows": "{emulator_dir}",
		  "linux": "{emulator_dir}"
		}
	  }
	}
  },
  "launch": {
	"platforms": {
	  "windows": {
		"type": "command",
		"executable": "xemu.exe",
		"template": [
		  "{exe}",
		  "-full-screen",
		  "-dvd_path",
          "{rom}"
		]
	  },
	  "linux": {
		"type": "command",
		"executable": "xemu",
		"template": [
		  "{exe}",
		  "-dvd_path",
          "{rom}"
		]
	  }
	}
  },
  "install": [
	{
	  "step": "download_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "download_repo",
		  "github_repo": "xemu-project/xemu",
		  "asset_pattern": "xemu-.*-windows-x86_64\\.zip"
		},
		"linux": {
		  "action_type": "download_repo",
		  "github_repo": "xemu-project/xemu",
		  "asset_pattern": "xemu-.*-x86_64\\.AppImage"
		}
	  }
	},
	{
	  "step": "install_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "extract",
		  "extract_to": ".",
		  "strip_top_directory": true,
		  "validate": {
			"action_type": "file_exists",
			"file": "xemu.exe"
		  }
		},
		"linux": {
		  "action_type": "none",
		  "validate": {
			"action_type": "file_exists",
			"file": "xemu"
		  }
		}
	  }
	},
	{
	  "step": "create_config",
	  "platforms": {
		"windows": {
		  "action_type": "create_files",
		  "files": [
			{
			  "name": "xemu.toml",
			  "content": "[general]\nshow_welcome = false\n\n[sys.files]\nbootrom_path = '{emulator_dir}/mcpx_1.0.bin'\nflashrom_path = '{emulator_dir}/Complex_4627.bin'\neeprom_path = '{emulator_dir}/eeprom.bin'\nhdd_path = '{emulator_dir}/xbox_hdd.raw'"
			}
		  ],
		  "validate": {
			"action_type": "files_exist",
			"files": [
              "xemu.toml"
			]
		  }
		},
		"linux": {
		  "action_type": "create_files",
		  "files": [
			{
			  "name": "xemu.toml",
			  "content": "[general]\nshow_welcome = false\n\n[sys.files]\nbootrom_path = '{emulator_dir}/mcpx_1.0.bin'\nflashrom_path = '{emulator_dir}/Complex_4627.bin'\neeprom_path = '{emulator_dir}/eeprom.bin'\nhdd_path = '{emulator_dir}/xbox_hdd.qcow2'"
			}
		  ],
		  "validate": {
			"action_type": "files_exist",
			"files": [
              "xemu.toml"
			]
		  }
		}
	  }
	}
  ]
}
