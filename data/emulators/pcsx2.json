{
  "suspend_method": "suspend",
  "meta": {
	"id": "pcsx2",
	"name": "PCSX2",
	"platforms": [
      "ps2"
	],
	"os": [
      "windows",
      "linux"
	]
  },
  "paths": {
	"default_saves": {
	  "_default": {
		"directories": {
		  "windows": "{emulator_dir}/memcards/main.ps2",
		  "linux": "{emulator_dir}/memcards/main.ps2"
		},
		"extensions": [
          "*"
		],
		"uses_folder_saves": true
	  }
	},
	"default_firmware": {
	  "_default": {
		"directories": {
		  "windows": "{emulator_dir}/bios",
		  "linux": "{emulator_dir}/bios"
		}
	  }
	}
  },
  "resolution": {
	"strategy": "pcsx2_ini",
	"config_candidates": {
	  "windows": ["{emulator_dir}/inis/PCSX2.ini"],
	  "linux": [
		"{home}/.config/PCSX2/inis/PCSX2.ini",
		"{emulator_dir}/inis/PCSX2.ini"
	  ]
	},
	"enforce": {
	  "windows": {
		"sections": {
		  "UI": {
			"SetupWizardIncomplete": "false"
		  },
		  "Folders": {
			"MemoryCards": "{emulator_dir}/memcards",
			"BIOS": "{emulator_dir}/bios"
		  },
		  "MemoryCards": {
		  }
		}
	  },
	  "linux": {
		"sections": {
		  "UI": {
			"SetupWizardIncomplete": "false"
		  },
		  "Folders": {
			"MemoryCards": "{emulator_dir}/memcards",
			"BIOS": "{emulator_dir}/bios"
		  },
		  "MemoryCards": {
			"Slot1_Enable": "true",
			"Slot1_Filename": "main.ps2"
		  }
		}
	  }
	}
  },
  "launch": {
	"platforms": {
	  "windows": {
		"type": "command",
		"executable": "pcsx2-qt.exe",
		"template": [
		  "{exe}",
		  "-nogui",
		  "-fullscreen",
          "{rom}"
		]
	  },
	  "linux": {
		"type": "command",
		"executable": "pcsx2-qt",
		"template": [
		  "{exe}",
		  "-nogui",
		  "-fullscreen",
		  "-batch",
		  "{rom}"
		]
	  }
	}
  },
  "install": [
	{
	  "step": "download_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "download_repo",
		  "github_repo": "PCSX2/pcsx2",
		  "asset_pattern": "pcsx2-.*-windows-x64-Qt\\.7z"
		},
		"linux": {
		  "action_type": "download_repo",
		  "github_repo": "PCSX2/pcsx2",
		  "asset_pattern": "pcsx2-.*-linux-appimage-x64-Qt\\.AppImage"
		}
	  }
	},
	{
	  "step": "install_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "extract",
		  "extract_to": ".",
		  "strip_top_directory": true,
		  "validate": {
			"action_type": "file_exists",
			"file": "pcsx2-qt.exe"
		  }
		},
		"linux": {
		  "action_type": "move",
		  "source_pattern": "pcsx2-*.AppImage",
		  "destination": "pcsx2-qt",
		  "replace": true,
		  "validate": {
			"action_type": "file_exists",
			"file": "pcsx2-qt"
		  }
		}
	  }
	},
	{
	  "step": "chmod_executable",
	  "platforms": {
		"windows": {
		  "action_type": "none"
		},
		"linux": {
		  "action_type": "chmod",
		  "file": "pcsx2-qt",
		  "mode": "+x",
		  "validate": {
			"action_type": "file_exists",
			"file": "pcsx2-qt"
		  }
		}
	  }
	},
	{
	  "step": "create_portable_mode",
	  "platforms": {
		"windows": {
		  "action_type": "create_files",
		  "files": [
            "portable.txt"
		  ],
		  "validate": {
			"action_type": "files_exist",
			"files": [
              "portable.txt"
			]
		  }
		},
		"linux": {
		  "action_type": "none"
		}
	  }
	},
	{
	  "step": "create_config_dir",
	  "platforms": {
		"windows": {
		  "action_type": "create_folders",
		  "folders": [
            "inis"
		  ],
		  "validate": {
			"action_type": "folder_exists",
			"path": "inis"
		  }
		},
		"linux": {
		  "action_type": "none"
		}
	  }
	},
	{
	  "step": "create_config",
	  "platforms": {
		"windows": {
		  "action_type": "create_files",
		  "files": [
			{
			  "name": "inis/PCSX2.ini",
			  "content": "[UI]\nSetupWizardIncomplete = false\nSettingsVersion = 1\n\n[Filenames]\nBIOS = ps2-0200a-20040614.bin\n\n[Folders]\nMemoryCards = {emulator_dir}/memcards\nBIOS = {emulator_dir}/bios\n\n[MemoryCards]\nSlot1_Enable = true\nSlot1_Filename = main.ps2"
			}
		  ],
		  "validate": {
			"action_type": "files_exist",
			"files": [
              "inis/PCSX2.ini"
			]
		  }
		},
		"linux": {
		  "action_type": "create_files",
		  "files": [
			{
			  "name": "{home}/.config/PCSX2/inis/PCSX2.ini",
			  "content": "[UI]\nSetupWizardIncomplete = false\nSettingsVersion = 1\n\n[Filenames]\nBIOS = ps2-0200a-20040614.bin\n\n[Folders]\nMemoryCards = {emulator_dir}/memcards\nBIOS = {emulator_dir}/bios\n\n[MemoryCards]\nSlot1_Enable = true\nSlot1_Filename = main.ps2"
			}
		  ],
		  "validate": {
			"action_type": "files_exist",
			"files": [
              "{home}/.config/PCSX2/inis/PCSX2.ini"
			]
		  }
		}
	  }
	},
	{
	  "step": "create_memcards_dir",
	  "platforms": {
		"windows": {
		  "action_type": "create_folders",
		  "folders": [
            "memcards/main.ps2"
		  ],
		  "validate": {
			"action_type": "folder_exists",
			"path": "memcards/main.ps2"
		  }
		},
		"linux": {
		  "action_type": "create_folders",
		  "folders": [
            "memcards/main.ps2"
		  ],
		  "validate": {
			"action_type": "folder_exists",
			"path": "memcards/main.ps2"
		  }
		}
	  }
	},
	{
	  "step": "create_superblock",
	  "platforms": {
		"windows": {
		  "action_type": "create_pcsx2_superblock",
		  "path": "memcards/main.ps2",
		  "validate": {
			"action_type": "files_exist",
			"files": [
              "memcards/main.ps2/_pcsx2_superblock"
			]
		  }
		},
		"linux": {
		  "action_type": "create_pcsx2_superblock",
		  "path": "memcards/main.ps2",
		  "validate": {
			"action_type": "files_exist",
			"files": [
              "memcards/main.ps2/_pcsx2_superblock"
			]
		  }
		}
	  }
	}
  ]
}
