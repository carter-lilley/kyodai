{
  "suspend_method": "suspend",
  "meta": {
	"id": "xenia",
	"name": "Xenia",
	"platforms": [
      "xbox360"
	]
  },
  "paths": {
	"saves": {
	  "_default": {
		"directories": {
		  "windows": "{emulator_dir}/content",
		  "linux": "{emulator_dir}/content",
		  "android": "{app_data}/content"
		},
		"extensions": [
          ".zip"
		],
		"uses_folder_saves": true
	  }
	},
	"firmware": {
	  "_default": {
		"directories": {}
	  }
	}
  },
  "launch": {
	"platforms": {
	  "windows": {
		"type": "command",
		"executable": "xenia_canary.exe",
		"template": [
		  "{exe}",
		  "{rom}",
          "--fullscreen"
		]
	  },
	  "linux": {
		"type": "command",
		"executable": "xenia_canary",
		"template": [
		  "{exe}",
          "{rom}"
		]
	  },
      "android": {
        "action": "android.intent.action.VIEW",
        "package": "emu.x360.mobile",
        "class": "emu.x360.mobile.X360MobileGameLaunchActivity",
        "rom_delivery": "intent_data",
        "mime_type": "application/octet-stream"
      }
	}
  },
  "install": [
	{
	  "step": "download_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "download_repo",
		  "github_repo": "xenia-canary/xenia-canary-releases",
		  "release_tag": "canary_experimental",
		  "asset_pattern": "xenia_canary_windows\\.zip"
		},
  		"linux": {
		  "action_type": "download_repo",
		  "github_repo": "xenia-canary/xenia-canary-releases",
		  "release_tag": "canary_experimental",
		  "asset_pattern": "xenia_canary_linux\\.tar\\.xz"
		},
		"android": {
		  "action_type": "download_repo",
		  "github_repo": "Ashnar2602/X360-Mobile---OFFICIAL",
		  "asset_pattern": "X360_.*_public\\.apk"
		}
	  }
	},
	{
	  "step": "install_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "extract",
		  "extract_to": ".",
		  "strip_top_directory": true,
		  "validate": {
			"action_type": "file_exists",
			"file": "xenia_canary.exe"
		  }
		},
		"linux": {
		  "action_type": "extract",
		  "extract_to": ".",
		  "strip_top_directory": true,
		  "validate": {
			"action_type": "file_exists",
			"file": "xenia_canary"
		  }
		},
		"android": {
		  "action_type": "apk_install",
		  "package_name": "emu.x360.mobile",
		  "expected_file": "*.apk",
		  "validate": {
			"action_type": "package_installed",
			"package": "emu.x360.mobile"
		  }
		}
	  }
	},
	{
	  "step": "create_portable_file",
	  "platforms": {
		"windows": {
		  "action_type": "create_files",
		  "files": [
			{
			  "name": "portable.txt",
			  "content": ""
			}
		  ],
		  "validate": {
			"action_type": "file_exists",
			"file": "portable.txt"
		  }
		},
		"linux": {
		  "action_type": "none"
		},
		"android": {
		  "action_type": "none"
		}
	  }
	}
  ]
}
