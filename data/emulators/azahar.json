{
	"suspend_method": "suspend",
	"meta": {
		"id": "azahar",
		"name": "Azahar",
		"platforms": [
			"3ds"
		],
		"os": [
			"windows",
			"linux",
			"android"
		]
	},
	"paths": {
		"default_saves": {
			"_default": {
				"directories": {
					"windows": "{emulator_dir}/user/sdmc/Nintendo 3DS/00000000000000000000000000000000/00000000000000000000000000000000",
					"android": "{emulator_dir}/sdmc/Nintendo 3DS/00000000000000000000000000000000/00000000000000000000000000000000"
				},
				"extensions": [
					"*"
				],
				"uses_folder_saves": true
			}
		},
		"default_firmware": {
			"_default": {
				"directories": {
					"windows": "{emulator_dir}/user",
					"linux": "{emulator_dir}/user",
					"android": "{emulator_dir}"
				}
			}
		}
	},
	"resolution": {
		"strategy": "azahar_ini",
		"config_candidates": {
			"windows": [
				"{emulator_dir}/user/config/qt-config.ini"
			],
			"linux": [
				"{emulator_dir}/user/config/qt-config.ini",
				"{home}/.config/azahar-emu/qt-config.ini",
				"{home}/.local/share/azahar-emu/config/qt-config.ini"
			]
		},
		"enforce": {
			"windows": {
				"sections": {
					"Data Storage": {
						"use_custom_storage": "true",
						"sdmc_directory": "{emulator_dir}/user/sdmc"
					}
				}
			},
			"linux": {
				"sections": {
					"Data Storage": {
						"use_custom_storage": "true",
						"sdmc_directory": "{emulator_dir}/user/sdmc"
					}
				}
			}
		}
	},
	"launch": {
		"platforms": {
			"windows": {
				"type": "command",
				"executable": "azahar.exe",
				"template": [
					"{exe}",
					"-f",
					"{rom}"
				]
			},
			"linux": {
				"type": "command",
				"executable": "squashfs-root/AppRun",
				"working_directory": "{emulator_dir}",
				"template": [
					"{exe}",
					"-f",
					"{rom}"
				]
			},
			"android": {
				"action": "android.intent.action.VIEW",
				"package": "org.azahar_emu.azahar",
				"rom_delivery": "intent_data"
			}
		}
	},
	"install": [
		{
			"step": "download_emulator",
			"platforms": {
				"windows": {
					"action_type": "download_repo",
					"github_repo": "azahar-emu/azahar",
					"asset_pattern": "azahar-windows-msvc-.*\\.zip"
				},
				"linux": {
					"action_type": "download_repo",
					"github_repo": "azahar-emu/azahar",
					"asset_pattern": "azahar\\.AppImage",
					"validate": {
						"action_type": "file_exists",
						"file": "azahar.AppImage"
					}
				},
				"android": {
					"action_type": "download_repo",
					"github_repo": "azahar-emu/azahar",
					"asset_pattern": "azahar-android-vanilla-.*\\.apk"
				}
			}
		},
		{
			"step": "install_emulator",
			"platforms": {
				"windows": {
					"action_type": "extract",
					"extract_to": ".",
					"strip_top_directory": true,
					"validate": {
						"action_type": "file_exists",
						"file": "azahar.exe"
					}
				},
				"linux": {
					"action_type": "none"
				},
				"android": {
					"action_type": "apk_install",
					"package_name": "org.azahar_emu.azahar",
					"expected_file": "azahar-android-vanilla-*.apk",
					"validate": {
						"action_type": "package_installed",
						"package": "org.azahar_emu.azahar"
					}
				}
			}
		},
		{
			"step": "chmod_emulator",
			"platforms": {
				"linux": {
					"action_type": "chmod",
					"file": "azahar.AppImage"
				}
			}
		},
		{
			"step": "extract_appimage",
			"platforms": {
				"linux": {
					"action_type": "appimage_extract",
					"pattern": "azahar.AppImage",
					"validate": {
						"action_type": "files_exist",
						"path": "squashfs-root",
						"pattern": "AppRun"
					}
				}
			}
		},
		{
			"step": "create_azahar_config_dir",
			"platforms": {
				"linux": {
					"action_type": "create_folders",
					"folders": [
						"user/config"
					]
				}
			}
		},
		{
			"step": "create_azahar_config",
			"platforms": {
				"linux": {
					"action_type": "create_files",
					"files": [
						{
							"name": "user/config/qt-config.ini",
							"content": "[Renderer]\ngraphics_api=2\n"
						}
					]
				}
			}
		}
	]
}
