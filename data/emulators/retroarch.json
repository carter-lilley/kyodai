{
  "meta": {
	"id": "retroarch",
	"name": "RetroArch",
	"platforms": [
	  "3do",
	  "arcade",
	  "atari2600",
	  "lynx",
	  "atomiswave",
	  "c64",
	  "dos",
	  "dc",
	  "fds",
	  "g-and-w",
	  "gb",
	  "gba",
	  "gbc",
	  "msx",
	  "naomi",
	  "naomi2",
	  "neogeoaes",
	  "neo-geo-pocket-color",
	  "n64",
	  "nes",
	  "win3x",
	  "pico8",
	  "psx",
	  "sega32",
	  "segacd",
	  "gamegear",
	  "sms",
	  "genesis",
	  "saturn",
	  "sg1000",
	  "snes",
	  "tg16",
	  "turbografx-cd",
      "virtualboy"
	]
  },
  "paths": {
	"saves": {
	  "_default": {
		"directories": {
		  "windows": "{emulator_dir}/saves",
		  "android": "/storage/emulated/0/RetroArch/saves"
		},
		"extensions": [
          ".srm"
		],
		"uses_folder_saves": false
	  }
	},
	"firmware": {
	  "_default": {
		"directories": {
		  "windows": "{emulator_dir}/system",
		  "android": "{emulator_dir}/system"
		}
	  }
	}
  },
  "launch": {
	"platforms": {
	  "windows": {
		"type": "command",
		"executable": "retroarch.exe",
		"template": [
		  "{exe}",
		  "-L",
		  "{core}",
		  "{rom}",
          "-f"
		]
	  },
	  "android": {
		"action": "android.intent.action.VIEW",
		"package": "com.retroarch",
		"class": "com.retroarch.browser.debug.CoreSideloadActivity",
		"rom_delivery": "extra",
		"extras": [
		  {
			"key": "ROM",
			"value": "{rom}",
			"type": "file_path"
		  },
		  {
			"key": "LIBRETRO",
			"value": "{core_path}",
			"type": "file_path"
		  }
		]
	  }
	}
  },
  "install": [
	{
	  "step": "download_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "download_scrape",
		  "scrape_url": "https://buildbot.libretro.com/stable/",
		  "version_pattern": "href=\"/stable/([0-9]+\\.[0-9]+\\.[0-9]+)/\"",
		  "url_template": "https://buildbot.libretro.com/stable/{version}/windows/x86_64/RetroArch.7z",
		  "match_strategy": "latest_semver"
		},
		"android": {
		  "action_type": "download_scrape",
		  "scrape_url": "https://buildbot.libretro.com/stable/",
		  "version_pattern": "href=\"/stable/([0-9]+\\.[0-9]+\\.[0-9]+)/\"",
		  "url_template": "https://buildbot.libretro.com/stable/{version}/android/RetroArch.apk",
		  "match_strategy": "latest_semver"
		}
	  }
	},
	{
	  "step": "install_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "extract",
		  "extract_to": ".",
		  "strip_top_directory": true,
		  "validate": {
			"action_type": "file_exists",
			"file": "retroarch.exe"
		  }
		},
		"android": {
		  "action_type": "apk_install",
		  "package_name": "com.retroarch",
		  "expected_file": "RetroArch.apk",
		  "validate": {
			"action_type": "package_installed",
			"package": "com.retroarch"
		  }
		}
	  }
	},
	{
	  "step": "download_cores",
	  "platforms": {
		"windows": {
		  "action_type": "download_scrape",
		  "scrape_url": "https://buildbot.libretro.com/stable/",
		  "version_pattern": "href=\"/stable/([0-9]+\\.[0-9]+\\.[0-9]+)/\"",
		  "url_template": "https://buildbot.libretro.com/stable/{version}/windows/x86_64/RetroArch_cores.7z",
		  "match_strategy": "latest_semver"
		},
		"android": {
		  "action_type": "batch_url_download",
		  "base_url": "https://buildbot.libretro.com/nightly/android/latest/arm64-v8a/",
		  "url_pattern": "{name}_libretro_android.so.zip",
		  "cores": [
			"opera",
			"mame2003_plus",
			"stella",
			"handy",
			"flycast",
			"vice_x64",
			"dosbox_pure",
			"nestopia",
			"gw",
			"gambatte",
			"mgba",
			"bluemsx",
			"fbneo",
			"mednafen_ngp",
			"mupen64plus_next_gles3",
			"swanstation",
			"picodrive",
			"genesis_plus_gx",
			"yabasanshiro",
			"snes9x",
			"mednafen_pce",
            "mednafen_vb"
		  ],
		  "extract_to": "{emulator_dir}/cores",
		  "validate": {
			"action_type": "files_exist",
			"path": "{emulator_dir}/cores",
			"pattern": "*_libretro_android.so"
		  }
		}
	  }
	},
	{
	  "step": "install_cores",
	  "platforms": {
		"windows": {
		  "action_type": "extract",
		  "extract_to": ".",
		  "strip_top_directory": true,
		  "flatten_target": "RetroArch-Win64",
		  "validate": {
			"action_type": "files_exist",
			"path": "cores",
			"pattern": "*.dll"
		  }
		},
		"android": {
		  "action_type": "extract",
		  "extract_to": "{emulator_dir}/cores",
		  "batch": true,
		  "validate": {
			"action_type": "files_exist",
			"path": "{emulator_dir}/cores",
			"pattern": "*_libretro_android.so"
		  }
		}
	  }
	}
  ],
  "cores": {
	"3do": {
	  "mapping": "opera",
	  "save_name": "Opera"
	},
	"arcade": {
	  "mapping": "mame2003_plus",
	  "save_name": "MAME 2003-Plus"
	},
	"atari2600": {
	  "mapping": "stella",
	  "save_name": "Stella"
	},
	"lynx": {
	  "mapping": "handy",
	  "save_name": "Handy"
	},
	"atomiswave": {
	  "mapping": "flycast",
	  "save_name": "Flycast"
	},
	"c64": {
	  "mapping": "vice_x64",
	  "save_name": "VICE x64"
	},
	"dos": {
