{
  "suspend_method": "udp",
  "meta": {
	"id": "retroarch",
	"name": "RetroArch",
	"platforms": [
	  "3do",
	  "arcade",
	  "atari2600",
	  "lynx",
	  "atomiswave",
	  "c64",
	  "dos",
	  "dc",
	  "fds",
	  "g-and-w",
	  "gb",
	  "gba",
	  "gbc",
	  "msx",
	  "naomi",
	  "naomi2",
	  "neogeoaes",
	  "neo-geo-pocket-color",
	  "n64",
	  "nds",
	  "nes",
	  "ngc",
	  "win3x",
	  "pico8",
	  "psx",
	  "ps2",
	  "psp",
	  "sega32",
	  "segacd",
	  "gamegear",
	  "sms",
	  "genesis",
	  "saturn",
	  "sg1000",
	  "snes",
	  "tg16",
	  "turbografx-cd",
	  "virtualboy",
	  "wii",
	  "3ds"
	],
	"os": [
      "windows",
      "linux",
      "android"
	]
  },
  "paths": {
	"default_saves": {
	  "_default": {
		"directories": {
		  "windows": "{emulator_dir}/saves",
		  "linux": "{emulator_dir}/saves",
		  "android": "/storage/emulated/0/RetroArch/saves"
		},
		"extensions": [
          ".srm"
		],
		"uses_folder_saves": false
	  }
	},
	"default_firmware": {
	  "_default": {
		"directories": {
		  "windows": "{emulator_dir}/system",
		  "linux": "{emulator_dir}/system",
		  "android": "/storage/emulated/0/RetroArch/system"
		}
	  }
	}
  },
  "resolution": {
	"strategy": "retroarch_cfg",
	"config_candidates": {
	  "windows": ["{emulator_dir}/retroarch.cfg"],
	  "linux": ["{emulator_dir}/retroarch.cfg"],
	  "android": ["/storage/emulated/0/RetroArch/retroarch.cfg"]
	}
  },
  "launch": {
	"platforms": {
	  "windows": {
		"type": "command",
		"executable": "retroarch.exe",
		"template": [
		  "{exe}",
		  "-L",
		  "{core}",
		  "{rom}",
          "-f"
		]
	  },
	  "linux": {
		"type": "command",
		"executable": "retroarch",
		"template": [
		  "{exe}",
		  "-L",
		  "{core}",
		  "{rom}",
		  "-f"
		]
	  },
	  "android": {
		"action": "android.intent.action.VIEW",
		"package": "com.retroarch",
		"class": "com.retroarch.browser.debug.CoreSideloadActivity",
		"rom_delivery": "extra",
		"extras": [
		  {
			"key": "ROM",
			"value": "{rom}",
			"type": "file_path"
		  },
		  {
			"key": "LIBRETRO",
			"value": "{core_path}",
			"type": "file_path"
		  }
		]
	  }
	}
  },
  "install": [
	{
	  "step": "download_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "download_scrape",
		  "scrape_url": "https://buildbot.libretro.com/stable/",
		  "version_pattern": "href=\"/stable/([0-9]+\\.[0-9]+\\.[0-9]+)/\"",
		  "url_template": "https://buildbot.libretro.com/stable/{version}/windows/x86_64/RetroArch.7z",
		  "match_strategy": "latest_semver"
		},
		"linux": {
		  "action_type": "download_scrape",
		  "scrape_url": "https://buildbot.libretro.com/stable/",
		  "version_pattern": "href=\"/stable/([0-9]+\\.[0-9]+\\.[0-9]+)/\"",
		  "url_template": "https://buildbot.libretro.com/stable/{version}/linux/x86_64/RetroArch.7z",
		  "match_strategy": "latest_semver"
		},
		"android": {
		  "action_type": "download_scrape",
		  "scrape_url": "https://buildbot.libretro.com/stable/",
		  "version_pattern": "href=\"/stable/([0-9]+\\.[0-9]+\\.[0-9]+)/\"",
		  "url_template": "https://buildbot.libretro.com/stable/{version}/android/RetroArch.apk",
		  "match_strategy": "latest_semver"
		}
	  }
	},
	{
	  "step": "install_emulator",
	  "platforms": {
		"windows": {
		  "action_type": "extract",
		  "extract_to": ".",
		  "strip_top_directory": true,
		  "validate": {
			"action_type": "file_exists",
			"file": "retroarch.exe"
		  }
		},
		"linux": {
		  "action_type": "extract",
		  "extract_to": ".",
		  "strip_top_directory": true,
		  "validate": {
			"action_type": "file_exists",
			"file": "retroarch"
		  }
		},
		"android": {
		  "action_type": "apk_install",
		  "package_name": "com.retroarch",
		  "expected_file": "RetroArch.apk",
		  "validate": {
			"action_type": "package_installed",
			"package": "com.retroarch"
		  }
		}
	  }
	},
	{
	  "step": "download_cores",
	  "platforms": {
		"windows": {
		  "action_type": "download_scrape",
		  "scrape_url": "https://buildbot.libretro.com/stable/",
		  "version_pattern": "href=\"/stable/([0-9]+\\.[0-9]+\\.[0-9]+)/\"",
		  "url_template": "https://buildbot.libretro.com/stable/{version}/windows/x86_64/RetroArch_cores.7z",
		  "match_strategy": "latest_semver"
		},
		"android": {
		  "action_type": "batch_url_download",
		  "dynamic_cores": true,
		  "base_url": "https://buildbot.libretro.com/nightly/android/latest/arm64-v8a/",
		  "url_pattern": "{name}_libretro_android.so.zip",
		  "extract_to": "{emulator_dir}/cores"
		}
	  }
	},
	{
	  "step": "install_cores",
	  "platforms": {
		"windows": {
		  "action_type": "extract",
		  "extract_to": ".",
		  "strip_top_directory": true,
		  "flatten_target": "RetroArch-Win64",
		  "validate": {
			"action_type": "files_exist",
			"path": "cores",
			"pattern": "*.dll"
		  }
		},
		"linux": {
		  "action_type": "extract",
		  "extract_to": ".",
		  "strip_top_directory": true,
		  "flatten_target": "RetroArch-Linux-x86_64",
		  "validate": {
			"action_type": "files_exist",
			"path": "cores",
			"pattern": "*.so"
		  }
		},
		"android": {
		  "action_type": "extract",
		  "extract_to": "{emulator_dir}/cores",
		  "batch": true,
		  "validate": {
			"action_type": "core_manifest"
		  }
		}
	  }
	}
  ],
