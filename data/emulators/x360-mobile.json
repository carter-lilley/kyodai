{
  "suspend_method": "suspend",
  "meta": {
	"id": "x360-mobile",
	"name": "X360 Mobile",
	"architecture": "xenia",
	"platforms": [
      "xbox360"
	],
	"os": [
      "android"
	]
  },
  "paths": {
	"saves": {
	  "_default": {
		"directories": {
		  "android": "{app_data}/content"
		},
		"extensions": [
          ".zip"
		],
		"uses_folder_saves": true
	  }
	},
	"firmware": {
	  "_default": {
		"directories": {}
	  }
	}
  },
  "launch": {
	"platforms": {
	  "android": {
		"action": "android.intent.action.VIEW",
		"package": "emu.x360.mobile",
		"class": "emu.x360.mobile.X360MobileGameLaunchActivity",
		"rom_delivery": "intent_data",
		"mime_type": "application/octet-stream"
	  }
	}
  },
  "install": [
	{
	  "step": "download_emulator",
	  "platforms": {
		"android": {
		  "action_type": "download_repo",
		  "github_repo": "Ashnar2602/X360-Mobile---OFFICIAL",
		  "asset_pattern": "X360_.*_public\\.apk"
		}
	  }
	},
	{
	  "step": "install_emulator",
	  "platforms": {
		"android": {
		  "action_type": "apk_install",
		  "package_name": "emu.x360.mobile",
		  "expected_file": "*.apk",
		  "validate": {
			"action_type": "package_installed",
			"package": "emu.x360.mobile"
		  }
		}
	  }
	}
  ]
}
