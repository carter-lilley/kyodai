{
  "suspend_method": "suspend",
  "meta": {
	"id": "armsx3",
	"name": "ARMSX3",
	"architecture": "rpcs3",
	"platforms": [
      "ps3"
	],
	"os": [
      "android"
	]
  },
  "paths": {
	"default_saves": {
	  "_default": {
		"directories": {
		  "android": "{app_data}/config/dev_hdd0/home/00000001/savedata"
		},
		"extensions": [
          "*"
		],
		"uses_folder_saves": true
	  }
	},
	"default_firmware": {
	  "_default": {
		"directories": {
		  "android": "{app_data}/config"
		}
	  }
	}
  },
  "resolution": {
	"strategy": "rpcs3_vfs",
	"anchor": "{app_data}/config",
	"config_candidates": {
	  "android": ["{app_data}/config/vfs.yml", "{app_data}/config/config.yml"]
	}
  },
  "launch": {
	"platforms": {
	  "android": {
		"action": "android.intent.action.VIEW",
		"package": "com.armsx3",
		"class": "com.armsx2.BootSplashActivity",
		"rom_delivery": "none",
		"extras": [
		  {
			"key": "path",
			"value": "{rom}",
			"type": "file_path"
		  }
		]
	  }
	}
  },
  "install": [
	{
	  "step": "download_emulator",
	  "platforms": {
		"android": {
		  "action_type": "download_repo",
		  "github_repo": "ARMSX2/ARMSX3",
		  "asset_pattern": "ARMSX3-.*-a11-armv8\\.2-sdk30\\.apk"
		}
	  }
	},
	{
	  "step": "install_emulator",
	  "platforms": {
		"android": {
		  "action_type": "apk_install",
		  "package_name": "com.armsx3",
		  "expected_file": "ARMSX3-*-a11-*.apk",
		  "validate": {
			"action_type": "package_installed",
			"package": "com.armsx3"
		  }
		}
	  }
	}
  ]
}
