{
  "suspend_method": "suspend",
  "meta": {
	"id": "shadps4",
	"name": "shadPS4",
	"platforms": [
      "ps4"
	],
	"os": [
      "windows",
      "linux"
	]
  },
  "requires_working_dir": true,
  "paths": {
	"default_saves": {
	  "_default": {
		"directories": {
		  "windows": "{emulator_dir}/user/savedata/1",
		  "linux": "{emulator_dir}/user/savedata/1"
		},
		"extensions": [
          "*"
		],
		"uses_folder_saves": true
	  }
	},
	"default_firmware": {
	  "_default": {
		"directories": {}
	  }
	}
  },
  "launch": {
	"platforms": {
	  "windows": {
		"type": "command",
		"executable": "shadps4.exe",
		"template": [
		  "{exe}",
		  "{rom}",
		  "--fullscreen",
          "true"
		]
	  },
	  "linux": {
		"type": "command",
		"executable": "shadps4",
		"template": [
		  "{exe}",
		  "{rom}",
		  "--fullscreen",
          "true"
		]
	  }
	}
  },
  "install": [
	{
	  "step": "download_core",
	  "platforms": {
		"windows": {
		  "action_type": "download_repo",
		  "github_repo": "shadps4-emu/shadPS4",
		  "asset_pattern": "shadps4-win64-sdl-.*\\.zip"
		},
		"linux": {
		  "action_type": "download_repo",
		  "github_repo": "shadps4-emu/shadPS4",
		  "asset_pattern": "shadps4-linux-sdl-.*\\.zip"
		}
	  }
	},
	{
	  "step": "install_core",
	  "platforms": {
		"windows": {
		  "action_type": "extract",
		  "extract_to": ".",
		  "strip_top_directory": false,
		  "validate": {
			"action_type": "file_exists",
			"file": "shadps4.exe"
		  }
		},
		"linux": {
		  "action_type": "extract",
		  "extract_to": ".",
		  "strip_top_directory": false,
		  "validate": {
			"action_type": "file_exists",
			"file": "shadps4"
		  }
		}
	  }
	},
	{
	  "step": "download_qt_launcher",
	  "platforms": {
		"windows": {
		  "action_type": "download_repo",
		  "github_repo": "shadps4-emu/shadps4-qtlauncher",
		  "asset_pattern": "shadPS4QtLauncher-win64-qt-.*\\.zip"
		},
		"linux": {
		  "action_type": "download_repo",
		  "github_repo": "shadps4-emu/shadps4-qtlauncher",
		  "asset_pattern": "shadPS4QtLauncher-linux-qt-.*\\.zip"
		}
	  }
	},
	{
	  "step": "install_qt_launcher",
	  "platforms": {
		"windows": {
		  "action_type": "extract",
		  "extract_to": ".",
		  "strip_top_directory": false,
		  "validate": {
			"action_type": "file_exists",
			"file": "shadPS4QtLauncher.exe"
		  }
		},
		"linux": {
		  "action_type": "extract",
		  "extract_to": ".",
		  "strip_top_directory": false,
		  "validate": {
			"action_type": "file_exists",
			"file": "shadPS4QtLauncher"
		  }
		}
	  }
	},
	{
	  "step": "create_user_directory",
	  "platforms": {
		"windows": {
		  "action_type": "create_folders",
		  "folders": [
			"user",
			"user/savedata",
            "user/savedata/1"
		  ],
		  "validate": {
			"action_type": "folder_exists",
			"path": "user/savedata/1"
		  }
		},
		"linux": {
		  "action_type": "create_folders",
		  "folders": [
			"user",
			"user/savedata",
            "user/savedata/1"
		  ],
		  "validate": {
			"action_type": "folder_exists",
			"path": "user/savedata/1"
		  }
		}
	  }
	},
	{
	  "step": "create_config",
	  "platforms": {
		"windows": {
		  "action_type": "create_files",
		  "files": [
			{
			  "name": "user/config.toml",
			  "content": "[GUI]\ninstallDirs = ['{games_dir}/ps4']\ninstallDirsEnabled = [true]"
			}
		  ],
		  "validate": {
			"action_type": "files_exist",
			"files": [
              "user/config.toml"
			]
		  }
		},
		"linux": {
		  "action_type": "create_files",
		  "files": [
			{
			  "name": "user/config.toml",
			  "content": "[GUI]\ninstallDirs = ['{games_dir}/ps4']\ninstallDirsEnabled = [true]"
			}
		  ],
		  "validate": {
			"action_type": "files_exist",
			"files": [
              "user/config.toml"
			]
		  }
		}
	  }
	}
  ]
}
