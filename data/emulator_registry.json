  "dolphin": {
	"name": "Dolphin",
	"platforms": ["ngc", "wii"],
	"install": [
	  {
		"step": "download_emulator",
		"platforms": {
		  "windows": {
			"action_type": "download_scrape",
			"scrape_url": "https://dolphin-emu.org/download/",
			"version_pattern": "/download/release/([0-9a-z]+)/",
			"url_template": "https://dl.dolphin-emu.org/releases/{version}/dolphin-{version}-x64.7z"
		  },
		  "linux": {
			"action_type": "download_url",
			"url": ""
		  },
		  "android": {
			"action_type": "download_scrape",
			"scrape_url": "https://dolphin-emu.org/download/",
			"version_pattern": "/download/release/([0-9a-z]+)/",
			"url_template": "https://dl.dolphin-emu.org/releases/{version}/dolphin-{version}.apk"
		  }
		}
	  },
	  {
		"step": "install_emulator",
		"platforms": {
		  "windows": {
			"action_type": "extract",
			"extract_to": ".",
			"strip_top_directory": true,
			"validate": {
			  "action_type": "file_exists",
			  "file": "Dolphin.exe"
			}
		  },
		  "linux": {
			"action_type": "none",
			"validate": {
			  "action_type": "file_exists",
			  "file": ""
			}
		  },
		  "android": {
			"action_type": "apk_install",
			"package_name": "org.dolphinemu.dolphinemu",
			"expected_file": "dolphin-*.apk",
			"validate": {
			  "action_type": "package_installed",
			  "package": "org.dolphinemu.dolphinemu"
			}
		  }
		}
	  },
	  {
		"step": "setup_portable_mode",
		"platforms": {
		  "windows": {
			"action_type": "create_files",
			"files": ["portable.txt"],
			"validate": {
			  "action_type": "files_exist",
			  "files": ["portable.txt"]
			}
		  },
		  "linux": {
			"action_type": "none"
		  },
		  "android": {
			"action_type": "none"
		  }
		}
	  }
	],
	"launch": {
	  "platforms": {
		"windows": {
		  "type": "command",
		  "executable": "Dolphin.exe",
		  "template": ["{exe}", "-e", "{rom}", "--batch", "--config", "Dolphin.Display.Fullscreen=True", "--config", "Dolphin.Interface.ConfirmStop=False"]
		},
		"linux": {
		  "type": "command",
		  "executable": "",
		  "template": []
		},
		"android": {
		  "type": "intent",
		  "action": "android.intent.action.MAIN",
		  "package": "org.dolphinemu.dolphinemu",
		  "class": "org.dolphinemu.dolphinemu.ui.main.MainActivity",
		  "grant_uri_permission": true,
		  "extras": [
			{
			  "key": "AutoStartFile",
			  "value": "{rom}",
			  "type": "content_uri"
			}
		  ]
		}
	  }
	}
  },
  "eden": {
	"name": "Eden",
	"platforms": ["switch"],
	"install": [
	  {
		"step": "download_emulator",
		"platforms": {
		  "windows": {
			"action_type": "download_repo",
			"github_repo": "eden-emu/eden",
			"api_base_url": "https://git.eden-emu.dev/api/v1",
			"asset_pattern": "Eden-Windows-.*-amd64-msvc.*\\.zip"
		  },
		  "linux": {
			"action_type": "download_repo",
			"github_repo": "eden-emu/eden",
			"api_base_url": "https://git.eden-emu.dev/api/v1",
			"asset_pattern": "Eden-Linux-.*-amd64-clang-pgo\\.AppImage"
		  },
		  "android": {
			"action_type": "download_repo",
			"github_repo": "eden-emu/eden",
			"api_base_url": "https://git.eden-emu.dev/api/v1",
			"asset_pattern": "Eden-Android-.*-standard\\.apk"
		  }
		}
	  },
	  {
		"step": "install_emulator",
		"platforms": {
		  "windows": {
			"action_type": "extract",
			"extract_to": ".",
			"strip_top_directory": true,
			"validate": {
			  "action_type": "file_exists",
			  "file": "eden.exe"
			}
		  },
		  "linux": {
			"action_type": "none",
			"validate": {
			  "action_type": "file_exists",
			  "file": "Eden-Linux-.*-amd64-clang-pgo\\.AppImage"
			}
		  },
		  "android": {
			"action_type": "apk_install",
			"package_name": "dev.eden.eden_emulator",
			"expected_file": "Eden-Android-*-standard.apk",
			"validate": {
			  "action_type": "package_installed",
			  "package": "dev.eden.eden_emulator"
			}
		  }
		}
	  },
	  {
		"step": "create_user_folders",
		"platforms": {
		  "windows": {
			"action_type": "create_folders",
			"folders": ["user", "user/nand/system/Contents/registered", "user/keys"],
			"validate": {
			  "action_type": "folder_exists",
			  "path": "user"
			}
		  },
		  "linux": {
			"action_type": "create_folders",
			"folders": ["user", "user/nand/system/Contents/registered", "user/keys"],
			"validate": {
			  "action_type": "folder_exists",
			  "path": "user"
			}
		  },
		  "android": {
			"action_type": "create_folders",
			"folders": ["{emulator_dir}/user", "{emulator_dir}/user/nand/system/Contents/registered", "{emulator_dir}/user/keys"],
			"validate": {
			  "action_type": "folder_exists",
			  "path": "{emulator_dir}/user"
			}
		  }
		}
	  },
	  {
		"step": "download_firmware",
		"platforms": {
		  "windows": {
			"action_type": "download_repo",
			"github_repo": "THZoria/NX_Firmware",
			"asset_pattern": "Firmware.*\\.zip"
		  },
		  "linux": {
			"action_type": "download_repo",
			"github_repo": "THZoria/NX_Firmware",
			"asset_pattern": "Firmware.*\\.zip"
		  },
		  "android": {
			"action_type": "download_repo",
			"github_repo": "THZoria/NX_Firmware",
			"asset_pattern": "Firmware.*\\.zip"
		  }
		}
	  },
	  {
		"step": "extract_firmware",
		"platforms": {
		  "windows": {
			"action_type": "extract",
			"extract_to": "user/nand/system/Contents/registered",
			"validate": {
			  "action_type": "folder_exists",
			  "path": "user/nand/system/Contents/registered"
			}
		  },
		  "linux": {
			"action_type": "extract",
			"extract_to": "user/nand/system/Contents/registered",
			"validate": {
			  "action_type": "folder_exists",
			  "path": "user/nand/system/Contents/registered"
			}
		  },
		  "android": {
			"action_type": "extract",
			"extract_to": "{emulator_dir}/user/nand/system/Contents/registered",
			"validate": {
			  "action_type": "files_exist",
			  "path": "{emulator_dir}/user/nand/system/Contents/registered",
			  "pattern": "*"
			}
		  }
		}
	  },
	  {
		"step": "download_keys",
		"platforms": {
		  "windows": {
			"action_type": "download_scrape",
			"scrape_url": "https://prodkeys.net/ryujinx-prod-keys-n28/",
			"version_pattern": "v([0-9]+\\.[0-9]+\\.[0-9]+)",
			"url_template": "https://files.prodkeys.net/ProdKeys.Net-{version}.zip"
		  },
		  "linux": {
			"action_type": "download_scrape",
			"scrape_url": "https://prodkeys.net/ryujinx-prod-keys-n28/",
			"version_pattern": "v([0-9]+\\.[0-9]+\\.[0-9]+)",
