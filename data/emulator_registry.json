  "retroarch": {
	"name": "RetroArch",
	"platforms": ["3do", "arcade", "atari2600", "lynx", "atomiswave", "c64", "dos", "dc", "fds", "g-and-w", "gb", "gba", "gbc", "msx", "naomi", "naomi2", "neogeoaes", "neo-geo-pocket-color", "3ds", "n64", "nds", "nes", "ngc", "win3x", "pico8", "psx", "ps2", "psp", "sega32", "segacd", "gamegear", "sms", "genesis", "saturn", "sg1000", "snes", "tg16", "turbografx-cd", "virtualboy", "wii"],
	"download": {
	  "type": "download_url",
	  "urls": {
		"windows": "https://buildbot.libretro.com/stable/1.22.2/windows/x86_64/RetroArch.7z",
		"linux": "",
		"android": ""
	  },
	  "extract": true,
	  "extract_to": ".",
	  "strip_top_directory": true
	},
	"executable_names": {
	  "windows": "retroarch.exe",
	  "linux": "RetroArch-Linux-x86_64.AppImage",
	  "android": "com.retroarch"
	},
	"launch_templates": {
	  "windows": ["{exe}", "-L", "{core}", "{rom}"],
	  "linux": ["{exe}", "-L", "{core}", "{rom}"],
	  "android": {
		"action": "android.intent.action.VIEW",
		"package": "com.retroarch",
		"class": "com.retroarch.browser.retroactivity.RetroActivityFuture",
		"extras": {
		  "ROM": "{rom}",
		  "LIBRETRO": "{core}"
		}
	  }
	},
	"core_mappings": {
	  "3do": "opera",
	  "arcade": "fbneo",
	  "atari2600": "stella",
	  "lynx": "handy",
	  "atomiswave": "flycast",
	  "c64": "vice_x64",
	  "dos": "dosbox_pure",
	  "dc": "flycast",
	  "fds": "nestopia",
	  "g-and-w": "gw",
	  "gb": "gambatte",
	  "gba": "mgba",
	  "gbc": "gambatte",
	  "msx": "bluemsx",
	  "naomi": "flycast",
	  "naomi2": "flycast",
	  "neogeoaes": "fbneo",
	  "neo-geo-pocket-color": "mednafen_ngp",
	  "3ds": "citra",
	  "n64": "mupen64plus_next",
	  "nds": "melonds",
	  "nes": "nestopia",
	  "ngc": "dolphin",
	  "win3x": "dosbox_pure",
	  "pico8": "",
	  "psx": "pcsx_rearmed",
	  "ps2": "pcsx2",
	  "psp": "ppsspp",
	  "sega32": "picodrive",
	  "segacd": "genesis_plus_gx",
	  "gamegear": "genesis_plus_gx",
	  "sms": "genesis_plus_gx",
	  "genesis": "genesis_plus_gx",
	  "saturn": "yabause",
	  "sg1000": "genesis_plus_gx",
	  "snes": "snes9x",
	  "tg16": "mednafen_pce",
	  "turbografx-cd": "mednafen_pce",
	  "virtualboy": "mednafen_vb",
	  "wii": "dolphin"
	},
	"post_install_tasks": [
	  {
		"type": "download_url",
		"urls": {
		  "windows": "https://buildbot.libretro.com/stable/1.22.2/windows/x86_64/RetroArch_cores.7z",
		  "linux": "",
		  "android": ""
		},
		"filenames": {
		  "windows": "RetroArch_cores.7z"
		},
		"extract_to": ".",
		"strip_top_directory": true,
		"flatten_target": "RetroArch-Win64",
		"validation": {
		  "type": "files",
		  "path": "cores",
		  "pattern": "*.dll"
		}
	  },
	  {
		"type": "download_repo",
		"github_repo": "Abdess/retroarch_system",
		"asset_pattern": ".*\\.(7z|zip|rar)$",
		"extract_to": "system",
		"extract": true,
		"strip_top_directory": true,
		"flatten_target": "bios",
		"validation": {
		  "type": "files",
		  "path": "system"
		}
	  }
	]
  },
