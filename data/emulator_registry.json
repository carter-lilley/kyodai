{
  "_meta": {
	"version": "3.0",
	"description": "Emulator registry for Kyodai launcher",
	"note": "Version 3.0 uses unified Android intent format. See retroarch or azahar examples."
  },
  "_platform_defaults": {
	"3do": "retroarch",
	"arcade": "retroarch",
	"atari2600": "retroarch",
	"lynx": "retroarch",
	"atomiswave": "retroarch",
	"c64": "retroarch",
	"dos": "retroarch",
	"dc": "retroarch",
	"fds": "retroarch",
	"g-and-w": "retroarch",
	"gb": "retroarch",
	"gba": "retroarch",
	"gbc": "retroarch",
	"msx": "retroarch",
	"naomi": "retroarch",
	"naomi2": "retroarch",
	"neogeoaes": "retroarch",
	"neo-geo-pocket-color": "retroarch",
	"3ds": "azahar",
	"n64": "retroarch",
	"nds": "melonds",
	"nes": "retroarch",
	"ngc": "dolphin",
	"win3x": "retroarch",
	"pico8": "retroarch",
	"psx": "retroarch",
	"ps2": "pcsx2",
	"ps3": "rpcs3",
	"ps4": "shadps4",
	"psp": "ppsspp",
	"psvita": "vita3k",
	"sega32": "retroarch",
	"segacd": "retroarch",
	"gamegear": "retroarch",
	"sms": "retroarch",
	"genesis": "retroarch",
	"saturn": "retroarch",
