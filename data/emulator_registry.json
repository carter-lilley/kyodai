	"virtualboy": "retroarch",
	"wii": "dolphin",
	"wiiu": "cemu",
	"switch": "eden",
	"xbox": "xemu",
	"xbox360": "xenia"
  },
  "retroarch": {
	"name": "RetroArch",
	"platforms": ["3do", "arcade", "atari2600", "lynx", "atomiswave", "c64", "dos", "dc", "fds", "g-and-w", "gb", "gba", "gbc", "msx", "naomi", "naomi2", "neogeoaes", "neo-geo-pocket-color", "3ds", "n64", "nds", "nes", "ngc", "win3x", "pico8", "psx", "ps2", "psp", "sega32", "segacd", "gamegear", "sms", "genesis", "saturn", "sg1000", "snes", "tg16", "turbografx-cd", "virtualboy", "wii"],
	"install": [
	  {
		"step": "download_emulator",
		"platforms": {
		  "windows": {
			"action_type": "download_url",
			"url": "https://buildbot.libretro.com/stable/1.22.2/windows/x86_64/RetroArch.7z"
		  },
		  "android": {
			"action_type": "download_url",
			"url": "https://buildbot.libretro.com/stable/1.22.2/android/RetroArch.apk"
		  }
		}
	  },
	  {
		"step": "install_emulator",
		"platforms": {
		  "windows": {
			"action_type": "extract",
			"extract_to": ".",
			"strip_top_directory": true,
			"validate": {
			  "action_type": "file_exists",
			  "file": "retroarch.exe"
			}
		  },
		  "android": {
			"action_type": "apk_install",
			"package_name": "com.retroarch",
			"validate": {
			  "action_type": "package_installed",
			  "package": "com.retroarch"
			}
		  }
		}
	  },
	  {
		"step": "download_cores",
		"platforms": {
		  "windows": {
			"action_type": "download_url",
			"url": "https://buildbot.libretro.com/stable/1.22.2/windows/x86_64/RetroArch_cores.7z"
		  },
		  "android": {
			"action_type": "batch_url_download",
			"base_url": "https://buildbot.libretro.com/nightly/android/latest/arm64-v8a/",
			"url_pattern": "{name}_libretro_android.so.zip",
			"cores": [
			  "gambatte", "snes9x", "genesis_plus_gx", "mgba", "nestopia",
			  "fbneo", "pcsx_rearmed", "ppsspp", "flycast", "dolphin",
			  "melonds", "mupen64plus_next", "bluemsx", "mednafen_ngp",
			  "citra", "vice_x64", "dosbox_pure", "gw", "picodrive",
			  "yabause", "mednafen_pce", "mednafen_vb", "pcsx2",
			  "stella", "handy", "opera"
			],
			"extract_to": "/storage/emulated/0/RetroArch/cores",
			"validate": {
			  "action_type": "files_exist",
			  "path": "/storage/emulated/0/RetroArch/cores",
			  "pattern": "*_libretro_android.so"
			}
		  }
		}
	  },
	  {
		"step": "install_cores",
		"platforms": {
		  "windows": {
			"action_type": "extract",
			"extract_to": ".",
			"strip_top_directory": true,
			"flatten_target": "RetroArch-Win64",
			"validate": {
			  "action_type": "files_exist",
			  "path": "cores",
			  "pattern": "*.dll"
			}
		  },
		  "android": {
			"action_type": "extract",
			"extract_to": "/storage/emulated/0/RetroArch/cores",
			"validate": {
			  "action_type": "files_exist",
			  "path": "/storage/emulated/0/RetroArch/cores",
			  "pattern": "*_libretro_android.so"
			}
		  }
		}
	  },
	  {
		"step": "download_system_files",
		"platforms": {
		  "all": {
			"action_type": "download_url",
			"url": "https://files.lilley.video/other_assets/retroarch_bios.zip"
		  }
		}
	  },
	  {
		"step": "install_system_files",
		"platforms": {
		  "windows": {
			"action_type": "extract",
			"extract_to": "system",
			"strip_top_directory": true,
			"flatten_target": "bios",
			"validate": {
			  "action_type": "files_exist",
			  "path": "system"
			}
		  },
		  "android": {
			"action_type": "extract",
			"extract_to": "/storage/emulated/0/RetroArch/system",
			"strip_top_directory": true,
			"flatten_target": "bios",
			"validate": {
			  "action_type": "files_exist",
			  "path": "/storage/emulated/0/RetroArch/system"
			}
		  }
		}
	  }
	],
	
	"launch": {
	  "platforms": {
		"windows": {
		  "type": "command",
		  "executable": "retroarch.exe",
		  "template": ["{exe}", "-L", "{core}", "{rom}"]
		},
		"android": {
		  "type": "intent",
		  "action": "android.intent.action.VIEW",
		  "package": "com.retroarch",
		  "class": "com.retroarch.browser.debug.CoreSideloadActivity",
		  "rom_delivery": "extra_file_path",
		  "mime_type": "application/octet-stream",
		  "grant_uri_permission": false,
		  "clear_task": false,
		  "extras": [
			{
			  "key": "ROM",
			  "value": "{rom}",
			  "type": "file_path"
			},
			{
			  "key": "LIBRETRO",
			  "value": "{core_path}",
			  "type": "string"
			}
		  ]
		}
	  }
	},
	
	"core_mappings": {
	  "3do": "opera",
	  "arcade": "fbneo",
	  "atari2600": "stella",
	  "lynx": "handy",
	  "atomiswave": "flycast",
	  "c64": "vice_x64",
	  "dos": "dosbox_pure",
	  "dc": "flycast",
	  "fds": "nestopia",
	  "g-and-w": "gw",
	  "gb": "gambatte",
	  "gba": "mgba",
	  "gbc": "gambatte",
	  "msx": "bluemsx",
	  "naomi": "flycast",
	  "naomi2": "flycast",
	  "neogeoaes": "fbneo",
	  "neo-geo-pocket-color": "mednafen_ngp",
	  "3ds": "citra",
	  "n64": "mupen64plus_next",
	  "nds": "melonds",
	  "nes": "nestopia",
	  "ngc": "dolphin",
	  "win3x": "dosbox_pure",
	  "pico8": "",
	  "psx": "pcsx_rearmed",
	  "ps2": "pcsx2",
	  "psp": "ppsspp",
	  "sega32": "picodrive",
	  "segacd": "genesis_plus_gx",
	  "gamegear": "genesis_plus_gx",
	  "sms": "genesis_plus_gx",
	  "genesis": "genesis_plus_gx",
	  "saturn": "yabause",
	  "sg1000": "genesis_plus_gx",
	  "snes": "snes9x",
	  "tg16": "mednafen_pce",
	  "turbografx-cd": "mednafen_pce",
	  "virtualboy": "mednafen_vb",
  	"wii": "dolphin"
  }
},
"azahar": {
	"name": "Azahar",
	"platforms": ["3ds"],
	"install": [
	  {
		"step": "download_emulator",
		"platforms": {
		  "windows": {
			"action_type": "download_repo",
			"github_repo": "azahar-emu/azahar",
			"asset_pattern": "azahar-.*-windows-msvc\\.zip"
		  },
		  "linux": {
			"action_type": "download_repo",
			"github_repo": "azahar-emu/azahar",
			"asset_pattern": "azahar\\.AppImage"
		  },
		  "android": {
			"action_type": "download_repo",
			"github_repo": "azahar-emu/azahar",
			"asset_pattern": "azahar-.*-android-vanilla\\.apk"
		  }
		}
	  },
	  {
		"step": "install_emulator",
		"platforms": {
		  "windows": {
			"action_type": "extract",
			"extract_to": ".",
			"strip_top_directory": true,
			"validate": {
			  "action_type": "file_exists",
			  "file": "azahar.exe"
			}
		  },
		  "linux": {
			"action_type": "none",
			"validate": {
			  "action_type": "file_exists",
			  "file": "azahar.AppImage"
			}
		  },
		  "android": {
			"action_type": "apk_install",
			"package_name": "io.github.lime3ds.android",
			"expected_file": "azahar-*-android-vanilla.apk",
			"validate": {
			  "action_type": "package_installed",
			  "package": "io.github.lime3ds.android"
			}
		  }
		}
	  },
	  {
		"step": "setup_user_folder",
		"platforms": {
		  "windows": {
			"action_type": "create_folders",
			"folders": ["user"],
			"validate": {
			  "action_type": "folder_exists",
			  "path": "user"
			}
		  },
		  "linux": {
			"action_type": "create_folders",
			"folders": ["user"],
			"validate": {
			  "action_type": "folder_exists",
			  "path": "user"
			}
		  },
		  "android": {
			"action_type": "none"
		  }
		}
	  }
	],
	"launch": {
	  "platforms": {
		"windows": {
		  "type": "command",
		  "executable": "azahar.exe",
		  "template": ["{exe}", "-f", "{rom}"]
		},
		"linux": {
		  "type": "command",
		  "executable": "azahar.AppImage",
		  "template": ["{exe}", "{rom}"]
		},
		"android": {
		  "type": "intent",
		  "action": "android.intent.action.VIEW",
		  "package": "io.github.lime3ds.android",
		  "class": "org.citra.citra_emu.activities.EmulationActivity",
		  "rom_delivery": "intent_data",
		  "mime_type": "application/octet-stream",
		  "grant_uri_permission": true,
		  "clear_task": true,
		  "extras": []
		}
}
  }
}
}
