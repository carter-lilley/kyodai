	  {
		"type": "create_folders",
		"folders": ["user/keys"],
		"validation": {
		  "type": "folders",
		  "folders": ["user/keys"]
		}
	  },
	  {
		"type": "download_scrape",
		"scrape_url": "https://prodkeys.net/ryujinx-prod-keys-n28/",
		"version_pattern": "v([0-9]+\\.[0-9]+\\.[0-9]+)",
		"url_template": "https://files.prodkeys.net/ProdKeys.Net-{version}.zip",
		"extract_to": "user/keys",
		"extract": true,
		"strip_top_directory": true,
		"validation": {
		  "type": "files",
		  "files": ["user/keys/prod.keys", "user/keys/title.keys"]
		}
	  }
	]
