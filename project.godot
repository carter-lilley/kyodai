; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="kyodai"
config/version="0.8.1-alpha"
boot_splash/show_image=false
run/main_scene="res://main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Forward Plus")
run/low_processor_mode=true
run/low_processor_mode_sleep_usec=8000
config/icon="res://kyodai_icon.svg"
addons/icon_finder/preview_size=24

[autoload]

IconsFonts="*uid://b573s24lmntbd"
SystemManager="*res://managers/system_manager/system_manager.tscn"
DataManager="*res://managers/data_manager/data_manager.tscn"
UIManager="*res://managers/ui_manager/ui_manager.tscn"
LaunchManager="*res://managers/launch_manager/launch_manager.tscn"

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://logs/session.log"

[display]

window/subwindows/embed_subwindows=false
display_server/driver.linuxbsd="wayland"
window/hdr/request_hdr_output.android=false

[editor_plugins]

enabled=PackedStringArray("res://addons/AynThor/plugin.cfg", "res://addons/KyodaiBridge/plugin.cfg", "res://addons/godot-sqlite/plugin.cfg", "res://addons/icons-fonts/plugin.cfg", "res://addons/m3/plugin.cfg", "res://addons/rakugo-nodes/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "purple",
"res://android/": "purple",
"res://assets/": "green",
"res://base_class/": "orange",
"res://bin/": "red",
"res://build/": "red",
"res://data/": "green",
"res://dist/": "purple",
"res://effects/": "yellow",
"res://managers/": "red",
"res://shaders/": "yellow",
"res://themes/": "teal",
"res://ui/": "blue"
}

