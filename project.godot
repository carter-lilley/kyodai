; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="kyodai"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]

SettingsManager="*res://managers/settings_manager.gd"
UIManager="*res://managers/ui_manager.gd"
DisplayManager="*res://managers/display_manager.gd"
PlatformManager="*res://managers/platform_manager.gd"
DataManager="*res://managers/data_manager.gd"
NetworkManager="*res://managers/network_manager.gd"
DownloadManager="*res://managers/download_manager.gd"
NotificationManager="*uid://igtredd7pthk"
LaunchManager="*res://managers/launch_manager.gd"
AudioManager="*res://managers/audio_manager.gd"
GameNativeManager="*res://managers/gamenative_manager.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/AynThor/plugin.cfg", "res://addons/PackageChecker/plugin.cfg")

