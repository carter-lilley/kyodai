[physics]

3d/physics_engine="Jolt Physics"

[plugins]

onscreenkeyboard/enabled=true

[rendering]

rendering_device/driver.windows="d3d12"
driver/threads/thread_model=0
textures/vram_compression/import_etc2_astc=true
viewport/hdr_2d=true
anti_aliasing/quality/msaa_2d=3
anti_aliasing/quality/use_debanding=true
renderer/rendering_method.android="mobile"
viewport/hdr_2d.android=false
anti_aliasing/quality/msaa_2d.android=1
anti_aliasing/quality/screen_space_aa.android=1
