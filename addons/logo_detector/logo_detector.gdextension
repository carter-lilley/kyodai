[configuration]
entry_symbol = "logo_detector_library_init"
compatibility_minimum = "4.3"
reloadable = false

[libraries]
windows.debug.x86_64 = "res://addons/logo_detector/bin/windows.x86_64/liblogo_detector.windows.template_release.x86_64.dll"
windows.release.x86_64 = "res://addons/logo_detector/bin/windows.x86_64/liblogo_detector.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/logo_detector/bin/linux.x86_64/liblogo_detector.linux.template_release.x86_64.so"
linux.release.x86_64 = "res://addons/logo_detector/bin/linux.x86_64/liblogo_detector.linux.template_release.x86_64.so"
android.debug.arm64 = "res://addons/logo_detector/bin/android.arm64/liblogo_detector.android.template_release.arm64.so"
android.release.arm64 = "res://addons/logo_detector/bin/android.arm64/liblogo_detector.android.template_release.arm64.so"

[dependencies]
windows.debug.x86_64 = {
    "res://addons/logo_detector/bin/windows.x86_64/onnxruntime.dll": "",
    "res://addons/logo_detector/bin/windows.x86_64/onnxruntime_providers_shared.dll": ""
}
windows.release.x86_64 = {
    "res://addons/logo_detector/bin/windows.x86_64/onnxruntime.dll": "",
    "res://addons/logo_detector/bin/windows.x86_64/onnxruntime_providers_shared.dll": ""
}
linux.debug.x86_64 = {
    "res://addons/logo_detector/bin/linux.x86_64/libonnxruntime.so": ""
}
linux.release.x86_64 = {
    "res://addons/logo_detector/bin/linux.x86_64/libonnxruntime.so": ""
}
android.debug.arm64 = {
    "res://addons/logo_detector/bin/android.arm64/libonnxruntime.so": ""
}
android.release.arm64 = {
    "res://addons/logo_detector/bin/android.arm64/libonnxruntime.so": ""
}
