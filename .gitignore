# logo_detector addon build artifacts
addons/logo_detector/build/
addons/logo_detector/bin/*
!addons/logo_detector/bin/.gitkeep
addons/logo_detector/thirdparty/onnxruntime/

# Cloned build dependency; CI clones it fresh per job.
godot-cpp/

# Godot 4+ specific ignores
.godot/
.import

# Godot / editor lock files and addon temp artifacts
**/~*.tmp
**/~*.TMP
**/~*.tmp~
**/~*.TMP~

node_modules/

# Android build artifacts and cache
android/.gradle/
android/**/build/
android/**/.idea/
android/**/local.properties
android/**/*.iml

# Android debug keystore (contains sensitive signing key)
android/*.keystore

# Keep only the addon AAR - ignore build outputs
# The canonical AAR is in addons/PackageChecker/ and should be in version control
android/plugin/PackageCheckerPlugin.aar
android/plugins/

# Local headless smoke-test artifacts
.kimi/smoke/
