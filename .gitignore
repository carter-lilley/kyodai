# Godot 4+ specific ignores
.godot/
.import

# Godot / editor lock files and addon temp artifacts
**/~*.tmp
**/~*.TMP
**/~*.tmp~
**/~*.TMP~

node_modules/

# Android build artifacts and cache
android/.gradle/
android/**/build/
android/**/.idea/
android/**/local.properties
android/**/*.iml

# Android debug keystore (contains sensitive signing key)
android/*.keystore

# Keep only the addon AAR - ignore build outputs
# The canonical AAR is in addons/KyodaiBridge/ and should be in version control
android/plugin/KyodaiBridgePlugin.aar
android/plugins/
# libsigil.so is staged here by build_plugin.sh from bin/sigil/android/
android/plugin/src/main/jniLibs/

# gdcef / CEF runtime binaries (download from gdcef releases)
cef_artifacts/

# Local headless smoke-test artifacts
.kimi/smoke/
addons/godot-sqlite/bin/~libgdsqlite.windows.template_debug.x86_64.dll
addons/AynThor/bin/~libaynthor_native.dll
